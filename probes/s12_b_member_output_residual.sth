\ S12 probe B — what the member dispatch actually leaves.
\ Exit stack exposes the leaked member-space variable on the Option output.
import: intrinsics * ;

type: Option['T]
| None
| Some 'T
;

trait: Cursor['It: * -> *]
  : next ( 'It['T] -- Option['T] 'It['T] ) ;
;

: drainB ['It: Cursor] ( i64 'It[i64] -- i64 Option[i64] )
  next swap ;
