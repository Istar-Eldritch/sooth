\ S12 probe H — end-to-end: a List-backed Cursor impl + a bound-generic drain.
\ The impl member checks on the concrete/mono route today; the bound-generic
\ consumer is where the leak bites. Post-fix this whole program should
\ build and print 6.
import: intrinsics * ;
import: core::list | List Nil Cons | ;

type: Option['T]
| None
| Some 'T
;

trait: Cursor['It: * -> *]
  : next ( 'It['T] -- Option['T] 'It['T] ) ;
;

impl: Cursor for List
  : next
    ~[ ( Nil ) drop None Nil ]
    ~[ ( Cons ) Cons> |v rest| rest ^> v Some swap ]
    List? ;
;

: drain ['It: Cursor] ( i64 'It[i64] -- i64 )
  next swap
  ~[ ( None ) drop drop ]
  ~[ ( Some ) Some> rot add swap drain ]
  Option? ;

: main ( -- )
  1 2 3 Nil Cons Cons Cons
  0 swap drain
  . ;
