/target

# Compiled tree-sitter grammar (rebuild with `tree-sitter build`); parser.c
# etc. are committed since they're what a C toolchain actually builds.
/tree-sitter-sooth/*.so

# Compiled example binaries land alongside their source (spec §9.2).
/examples/*
!/examples/*.sth
# The examples are a package (P8): its manifest is source, not an artifact.
!/examples/sooth.pkg
# `resources.sth` reads this fixture at run time: source, not an artifact.
!/examples/resource_fixture.txt

# Scratch sources a panicking test leaked into the repo root before it could
# clean up (should live under `temp_dir()`, but guard against the pattern too).
/sooth-*-witness-*.sth
