import: intrinsics * ;
import: core::prelude * ;
\ `bool` names a type in an effect below, and a type name resolves against
\ its declaring module rather than following the prelude hub's re-export.
import: core::bool b | Bool | ;

: pos ( i64 -- Bool )
  0 gt ;

: classify ( i64 -- i64 )
  pos ~[ 1 ] ~[ 0 ] if ;

: main ( -- )
  7 classify . ;    \ prints 1
