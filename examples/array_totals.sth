\ Dogfood: Phase 4 slice 6a. An earlier hand-threaded array walk (three
\ manual `times` loops with a synthesized `>usize` index, `&arr i &> @`
\ reads and `&!arr i &!> v !` writes) rewritten over `each`/`map`/`fold`
\ from `lib/combinators.sth`: the total and the doubled elements, now three
\ one-line combinator calls instead of three hand-threaded loop bodies.

import: c "../lib/combinators.sth" ;

: scores ( -- [i64 5] )
  0 5 fill | s |
  &!s 0 >usize &!> 3 !
  &!s 1 >usize &!> 7 !
  &!s 2 >usize &!> 1 !
  &!s 3 >usize &!> 9 !
  &!s 4 >usize &!> 5 !
  s ;

: main ( -- )
  scores 0 [ + ] c::fold .              \ 25, the total
  scores [ 2 * ] c::map [ . ] c::each ; \ 6 14 2 18 10, each doubled
