: sum-to ( i64 i64 -- i64 )
  | acc n |
  n 0 = if
    acc
  else
    acc n + n 1 - sum-to
  end ;

: main ( -- )
  0 1000000 sum-to . ;    \ prints 500000500000; overflows the host stack
                          \ under naive recursion, completes in constant
                          \ stack under the self-tail-call -> loop transform
