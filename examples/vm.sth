\ Dogfood: Phase 2 exit, now with Slice 6 references. A fixed-size bytecode
\ stack machine that interprets a toy instruction set, composing fixed-size
\ arrays, `usize`, enums with clause dispatch, structs, and the Slice 6
\ self-tail-call dispatch loop.
\
\ `Op` is mixed-arity: `Push`/`Load`/`Store`/`Jz`/`Jmp` carry a `i64`/`usize`
\ payload; `Add`/`Sub`/`Mul`/`Halt` do not. `Vm` bundles the whole machine
\ state (program, program counter, operand stack + cursor, addressable
\ memory) so it can ride across the dispatch loop's tail-call back-edge as a
\ single value.
\
\ A user word may only return one value through a call (see
\ `examples/stack.sth`), so `vm-pop` bundles its `(Vm, i64)` result into a
\ `VmPop` struct, destructured inline by the caller with the generated
\ `VmPop>` word. `Fetched` bundles `run`'s `(Vm, Op)` fetch result the same
\ way.
\
\ `run`'s `Add`/`Sub`/`Mul`/`Store` clauses (Phase 3 Slice 5) name the first
\ `vm-pop` result with a mid-body `| ... |` binding instead of shuffling it
\ into position with `swap`/`over`/`rot`. `vm-push`/`vm-pop`/`fetch` and
\ `run`'s `Load`/`Store` clauses (Slice 6) read and write the operand stack
\ and memory arrays through a reference instead of `get`/`set`'s
\ read-two-outputs / rebuild-the-whole-array shapes.

type: Op
| Push v i64
| Add
| Sub
| Mul
| Load  addr usize
| Store addr usize
| Jz    target usize
| Jmp   target usize
| Halt
;

type: Vm
  prog  [Op 13]
  pc    usize
  stack [i64 8]
  sp    usize
  mem   [i64 4]
;

type: Fetched vm Vm op Op ;
type: VmPop vm Vm val i64 ;

: vm-push ( Vm i64 -- Vm )
  | vm x |
  vm Vm>sp | i |
  &!vm &!Vm>stack i &!> x !
  vm vm Vm>sp 1 + Vm<sp ;

: vm-pop ( Vm -- VmPop )
  | vm |
  vm Vm>sp 1 - | i |
  &vm &Vm>stack i &> @ | x |
  vm i Vm<sp
  x
  VmPop ;

: bump-pc ( Vm -- Vm )
  dup Vm>pc 1 + Vm<pc ;

: fetch ( Vm -- Fetched )
  | vm |
  vm Vm>pc | i |
  &vm &Vm>prog i &> @ | op |
  vm op Fetched ;

\ Nine-clause self-tail-recursive dispatch loop. Every non-`Halt` clause
\ produces an updated `Vm`, refetches the next `Op` out of the carried
\ `prog`, and tail-calls `run` (the Slice 6 back-edge). `Halt` returns the
\ popped operand-stack top without a self-call (the base case that `Ret`s).
: run ( Vm Op -- i64 )
| Push  | vm v |
    vm v vm-push
    bump-pc
    fetch Fetched> run
| Add   | vm |
    vm vm-pop VmPop>          \ vm b
    | b |
    vm-pop VmPop>              \ vm'' a
    b +
    vm-push
    bump-pc
    fetch Fetched> run
| Sub   | vm |
    vm vm-pop VmPop>
    | b |
    vm-pop VmPop>
    b -
    vm-push
    bump-pc
    fetch Fetched> run
| Mul   | vm |
    vm vm-pop VmPop>
    | b |
    vm-pop VmPop>
    b *
    vm-push
    bump-pc
    fetch Fetched> run
| Load  | vm addr |
    &vm &Vm>mem addr &> @ | x |
    vm x vm-push
    bump-pc
    fetch Fetched> run
| Store | vm addr |
    vm vm-pop VmPop>           \ v x
    | v x |
    &!v &!Vm>mem addr &!> x !
    v
    bump-pc
    fetch Fetched> run
| Jz    | vm target |
    vm vm-pop VmPop>           \ vm' x
    0 =
    if
      target Vm<pc
    else
      bump-pc
    end
    fetch Fetched> run
| Jmp   | vm target |
    vm target Vm<pc
    fetch Fetched> run
| Halt  | vm |
    vm vm-pop VmPop>
    swap drop
;

\ Assembles the sum-1..N-via-bytecode program (fill, then write each opcode
\ through a reference into a named local, no array literal):
\   0  Load  0    (L)   push i
\   1  Jz    11         if i == 0 goto E
\   2  Load  1          push acc
\   3  Load  0          push i
\   4  Add               acc + i
\   5  Store 1          acc = acc + i
\   6  Load  0          push i
\   7  Push  1
\   8  Sub               i - 1
\   9  Store 0          i = i - 1
\   10 Jmp   0          backward branch to L
\   11 Load  1    (E)   push acc
\   12 Halt             result = acc on top of stack (seeded by fill)
: build ( -- [Op 13] )
  Halt 13 fill | prog |
  &!prog 0  >usize &!> 0  >usize Load  !
  &!prog 1  >usize &!> 11 >usize Jz    !
  &!prog 2  >usize &!> 1  >usize Load  !
  &!prog 3  >usize &!> 0  >usize Load  !
  &!prog 4  >usize &!> Add !
  &!prog 5  >usize &!> 1  >usize Store !
  &!prog 6  >usize &!> 0  >usize Load  !
  &!prog 7  >usize &!> 1 Push !
  &!prog 8  >usize &!> Sub !
  &!prog 9  >usize &!> 0  >usize Store !
  &!prog 10 >usize &!> 0  >usize Jmp   !
  &!prog 11 >usize &!> 1  >usize Load  !
  prog ;

: main ( -- )
  build
  0 >usize                       \ pc = 0
  0 8 fill
  0 >usize                       \ sp = 0
  0 4 fill | mem |
  &!mem 0 >usize &!> 100000 !    \ mem[0] = N = 100000, mem[1] = 0
  mem
  Vm
  fetch Fetched> run . ;
