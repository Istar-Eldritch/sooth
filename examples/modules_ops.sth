\ Dogfood: Phase 4 Slice 5a (R24). The words half of the two-file library:
\ componentwise `add` and squared length `len2` over `point::Point`, imported
\ by type from `examples/modules_point.sth` and exported for
\ `examples/modules.sth` to call qualified.

import: point | Point | "modules_point.sth" ;

: add ( Point Point -- Point )
  | a b |
  &a &x @ &b &x @ +
  &a &y @ &b &y @ +
  Point ;

: len2 ( Point -- i64 )
  | p |
  &p &x @ &p &x @ *
  &p &y @ &p &y @ *
  + ;

export: add len2 ;
