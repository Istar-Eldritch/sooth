\ Phase 4 Slice 6e dogfood: `if` in a polymorphic body. `mymax`/`choose` each
\ branch once; `mymax3` nests an `if` inside an `if` arm, checking D4's claim
\ that nested `if` falls out of the recursive poly-walk rather than needing a
\ dedicated mechanism.

import: intrinsics * ;
import: core::prelude * ;
\ `bool` names a type in an effect below, and a type name resolves against
\ its declaring module rather than following the prelude hub's re-export.
import: core::bool b | bool | ;

: mymax inline ( 'T: Copy Ord 'T -- 'T ) over over gt ~[ drop ] ~[ swap drop ] if ;

: choose inline ( 'T 'T bool -- 'T ) | a b flag | flag ~[ a b drop ] ~[ b a drop ] if ;

: mymax3 inline ( 'T: Copy Ord 'T 'T -- 'T )
  | a b c |
  a b gt ~[
    a c gt ~[ a ] ~[ c ] if
  ] ~[
    b c gt ~[ b ] ~[ c ] if
  ] if ;

: main ( -- )
  2 5 9 mymax3 .
  2.0 5.0 9.0 mymax3 . ;
