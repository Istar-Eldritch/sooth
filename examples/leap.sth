\ Leap-year predicate: compound boolean logic dogfood for `and`/`or`/`not` on
\ `bool`. A year is leap if divisible by 4 and not by 100, or divisible by 400.

import: intrinsics * ;
import: core::prelude * ;
\ `bool` names a type in an effect below and a bool is printed with `.`, and
\ neither a type name nor an operator overload follows the prelude hub's
\ re-export: both come from the declaring module.
import: core::bool b | bool . | ;

: leap ( i64 -- bool )
  dup 4 mod 0 eq
  over 100 mod 0 eq not
  and
  swap 400 mod 0 eq
  or ;

: main ( -- )
  2000 leap .    \ prints true (divisible by 400)
  1900 leap .    \ prints false (divisible by 100, not 400)
  2024 leap . ;  \ prints true (divisible by 4, not 100)
