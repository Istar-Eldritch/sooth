\ Leap-year predicate: compound boolean logic dogfood for `and`/`or`/`not` on
\ `bool`. A year is leap if divisible by 4 and not by 100, or divisible by 400.

import: intrinsics * ;
import: core::prelude * ;
\ A bool is printed with `.` below, and an operator overload does not follow
\ the prelude hub's re-export (one hop only): it comes from the declaring
\ module. `Bool` itself comes through `core::prelude`'s own re-export.
import: core::bool b | . | ;

: leap ( i64 -- Bool )
  dup 4 mod 0 eq
  over 100 mod 0 eq not
  and
  swap 400 mod 0 eq
  or ;

: main ( -- )
  2000 leap .    \ prints True (divisible by 400)
  1900 leap .    \ prints False (divisible by 100, not 400)
  2024 leap . ;  \ prints True (divisible by 4, not 100)
