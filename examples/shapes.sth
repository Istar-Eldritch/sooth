type: Shape
| Circle r f64
| Rect   w f64 h f64
;

type: MaybeInt | None | Some v i64 ;

: area ( Shape -- f64 )
  ~[ ( Circle ) Circle> dup mul 3.14159 mul ]
  ~[ ( Rect )   Rect> | w h | w h mul ]
  Shape? ;

: unwrap-or ( i64 MaybeInt -- i64 )
  ~[ ( None ) drop ]
  ~[ ( Some ) Some> swap drop ]
  MaybeInt? ;

: main ( -- )
  2.0 Circle area .          \ ~12.56636
  3.0 4.0 Rect area .        \ 12
  5 None unwrap-or .         \ 5   (the None arm drops its receiver, yielding the default)
  5 7 Some unwrap-or . ;     \ 7
