\ The hand-threaded baseline for Phase 4 slice 6a's dogfood. Its combinator twin
\ `examples/array_totals.sth` expresses the same array walk over
\ `each`/`map`/`fold` from `lib/combinators.sth`; the golden pins both to the
\ same output. Three manual `times` loops over one array, each with a
\ synthesized `>usize` index, a `&arr i &> @` read and (for the doubling loop) a
\ `&!arr i &!> v !` write.

import: intrinsics * ;

import: core::combinators c | times | ;

: scores ( -- array[i64 5] )
  0 5 fill | s |
  &!s 0 >usize &!> 3 !
  &!s 1 >usize &!> 7 !
  &!s 2 >usize &!> 1 !
  &!s 3 >usize &!> 9 !
  &!s 4 >usize &!> 5 !
  s ;

: main ( -- )
  scores | arr |
  0 5 ~[ | i | &arr i >usize &> @ add ] times .
  5 ~[ | i | &arr i >usize &> @ 2 mul | v | &!arr i >usize &!> v ! ] times
  5 ~[ | i | &arr i >usize &> @ . ] times
  arr drop ;
