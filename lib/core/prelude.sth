\ core::prelude -- the hub. It declares no words of its own; it re-exports the
\ typed core the compiler used to inject into every program, so a consumer
\ writes one `import: core::prelude * ;` for the whole surface instead of one
\ line per module. Nothing is implicit: a program that wants none of this
\ imports none of it.
\
\ Printing is not here and cannot be: `.` is `hosted::show`'s vocabulary, one
\ concrete dot per printable type over `core::show`'s `Show` trait, and this
\ is a `core` hub. A program that prints imports `hosted::show` directly.
import: intrinsics | drop | ;
import: self::bool | if unless Bool False True | ;
import: self::cmp | Ord Ordering Less Equal Greater eq lt gt lte gte ne | ;

export: drop if unless Bool False True Ord Ordering Less Equal Greater eq lt gt lte gte ne ;
