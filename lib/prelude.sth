\ core::prelude -- the hub. It declares no words of its own; it re-exports the
\ typed core the compiler used to inject into every program, so a consumer
\ writes one `import: core::prelude * ;` for the whole surface instead of one
\ line per module. Nothing is implicit: a program that wants none of this
\ imports none of it.
\
\ One of `core::bool`'s names does not appear here. The bool `.` overload
\ cannot: an operator overload's candidate lookup considers the calling
\ module and the module it selectively imported the name from, one hop, so a
\ hub in between hides the declaring module. A program that prints a `Bool`
\ imports `core::bool` directly; everything else comes through here.
import: intrinsics | drop | ;
import: self::bool | if unless Bool False True | ;
import: self::cmp | eq lt gt lte gte ne | ;

export: drop if unless Bool False True eq lt gt lte gte ne ;
