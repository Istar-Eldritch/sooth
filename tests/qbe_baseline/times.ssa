data $fmt = { b "%ld\n", b 0 }
data $ufmt = { b "%lu\n", b 0 }
data $ffmt = { b "%g\n", b 0 }
data $sfmt = { b "%s", b 0 }
data $oobfmt = { b "sooth: array index out of range (line %ld)\n  index %ld is out of bounds for length %ld\n", b 0 }
data $allocfmt = { b "alloc %ld\n", b 0 }
data $freefmt = { b "free %ld\n", b 0 }
data $tracenv = { b "SOOTH_TRACE_ALLOC", b 0 }
data $oomfmt = { b "sooth: out of memory (allocation of %ld bytes failed)\n", b 0 }
data $strfmt = { b "%.*s", b 0 }
type :arr_0 = align 8 { b 32 }

export function $sooth_main() {
@start
	%v0 =l copy 0
	%v1 =l copy 1000000
	%v3 =l copy 0
	jmp @blk1
@blk1
	%v4 =l phi @start %v0, @blk5 %v18
	%v5 =l phi @start %v3, @blk5 %v20
	%v6 =l phi @start %v1, @blk5 %v6
	%v7 =w csltl %v5, %v6
	jnz %v7, @blk2, @blk3
@blk2
	%v10 =w copy 1
	jmp @blk4
@blk3
	%v11 =w copy 0
	jmp @blk4
@blk4
	%v12 =w phi @blk2 %v10, @blk3 %v11
	%v15 =w copy %v12
	jnz %v15, @blk5, @blk6
@blk5
	%v16 =l copy 1
	%v17 =l add %v5, %v16
	%v18 =l add %v4, %v17
	%v19 =l copy 1
	%v20 =l add %v5, %v19
	jmp @blk1
@blk6
	jmp @blk7
@blk7
	call $printf(l $fmt, l %v4, ...)
	ret
}

function $sooth_oob_trap(l %line, l %idx, l %len) {
@start
	call $dprintf(w 2, l $oobfmt, l %line, l %idx, l %len, ...)
	call $exit(w 1)
	hlt
}

function l $sooth_alloc(l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	%p =l call $malloc(l %adj)
	%isnull =w ceql %p, 0
	jnz %isnull, @oom, @ok
@oom
	call $sooth_oom_trap(l %adj)
	hlt
@ok
	call $sooth_trace_event(l $allocfmt, l %adj)
	ret %p
}

function $sooth_free(l %p, l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	call $free(l %p)
	call $sooth_trace_event(l $freefmt, l %adj)
	ret
}

function $sooth_oom_trap(l %n) {
@start
	call $dprintf(w 2, l $oomfmt, l %n, ...)
	call $exit(w 1)
	hlt
}

function $sooth_trace_event(l %fmt, l %n) {
@start
	%e =l call $getenv(l $tracenv)
	%unset =w ceql %e, 0
	jnz %unset, @off, @set
@set
	%c =w loadub %e
	jnz %c, @on, @off
@on
	call $printf(l %fmt, l %n, ...)
	ret
@off
	ret
}
