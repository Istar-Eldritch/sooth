export function $sooth_main() {
@start
	%v0 =l copy 0
	%v1 =l copy 1000000
	%v3 =l copy 0
	jmp @blk1
@blk1
	%v4 =l phi @start %v0, @blk7 %v24
	%v5 =l phi @start %v3, @blk7 %v26
	%v6 =l phi @start %v1, @blk7 %v6
	%v7 =w call $cmp.3b.Ord.3b.4.3b.i64__m4(l %v5, l %v6)
	%v11 =w copy 0
	%v12 =w ceqw %v7, %v11
	jnz %v12, @blk2, @blk5
@blk5
	%v13 =w copy 1
	%v14 =w ceqw %v7, %v13
	jnz %v14, @blk3, @blk4
@blk2
	%v15 =w copy 1
	jmp @blk6
@blk3
	%v16 =w copy 0
	jmp @blk6
@blk4
	%v17 =w copy 0
	jmp @blk6
@blk6
	%v18 =w phi @blk2 %v15, @blk3 %v16, @blk4 %v17
	%v21 =w copy %v18
	jnz %v21, @blk7, @blk8
@blk7
	%v22 =l copy 1
	%v23 =l add %v5, %v22
	%v24 =l add %v4, %v23
	%v25 =l copy 1
	%v26 =l add %v5, %v25
	jmp @blk1
@blk8
	jmp @blk9
@blk9
	call $printf(l $fmt, l %v4, ...)
	ret
}

