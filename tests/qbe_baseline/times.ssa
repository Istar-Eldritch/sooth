data $fmt = { b "%ld\n", b 0 }
data $ufmt = { b "%lu\n", b 0 }
data $ffmt = { b "%g\n", b 0 }
data $sfmt = { b "%s", b 0 }
data $oobfmt = { b "sooth: array index out of range (line %ld)\n  index %ld is out of bounds for length %ld\n", b 0 }
data $allocfmt = { b "alloc %ld\n", b 0 }
data $freefmt = { b "free %ld\n", b 0 }
data $tracenv = { b "SOOTH_TRACE_ALLOC", b 0 }
data $oomfmt = { b "sooth: out of memory (allocation of %ld bytes failed)\n", b 0 }
data $strfmt = { b "%.*s", b 0 }
type :arr_0 = align 8 { b 32 }

export function $sooth_main() {
@start
	%v0 =l copy 0
	%v1 =l copy 1000000
	%v3 =l copy 0
	jmp @blk1
@blk1
	%v4 =l phi @start %v0, @blk13 %v34
	%v5 =l phi @start %v3, @blk13 %v36
	%v6 =l phi @start %v1, @blk13 %v6
	%v7 =w csltl %v5, %v6
	jnz %v7, @blk2, @blk3
@blk2
	%v10 =w copy 0
	jmp @blk4
@blk3
	%v11 =w csgtl %v5, %v6
	jnz %v11, @blk5, @blk6
@blk5
	%v14 =w copy 2
	jmp @blk7
@blk6
	%v15 =w copy 1
	jmp @blk7
@blk7
	%v16 =w phi @blk5 %v14, @blk6 %v15
	jmp @blk4
@blk4
	%v17 =w phi @blk2 %v10, @blk7 %v16
	%v21 =w copy 0
	%v22 =w ceqw %v17, %v21
	jnz %v22, @blk8, @blk11
@blk11
	%v23 =w copy 1
	%v24 =w ceqw %v17, %v23
	jnz %v24, @blk9, @blk10
@blk8
	%v25 =w copy 1
	jmp @blk12
@blk9
	%v26 =w copy 0
	jmp @blk12
@blk10
	%v27 =w copy 0
	jmp @blk12
@blk12
	%v28 =w phi @blk8 %v25, @blk9 %v26, @blk10 %v27
	%v31 =w copy %v28
	jnz %v31, @blk13, @blk14
@blk13
	%v32 =l copy 1
	%v33 =l add %v5, %v32
	%v34 =l add %v4, %v33
	%v35 =l copy 1
	%v36 =l add %v5, %v35
	jmp @blk1
@blk14
	jmp @blk15
@blk15
	call $printf(l $fmt, l %v4, ...)
	ret
}

function $sooth_oob_trap(l %line, l %idx, l %len) {
@start
	call $dprintf(w 2, l $oobfmt, l %line, l %idx, l %len, ...)
	call $exit(w 1)
	hlt
}

function l $sooth_alloc(l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	%p =l call $malloc(l %adj)
	%isnull =w ceql %p, 0
	jnz %isnull, @oom, @ok
@oom
	call $sooth_oom_trap(l %adj)
	hlt
@ok
	call $sooth_trace_event(l $allocfmt, l %adj)
	ret %p
}

function $sooth_free(l %p, l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	call $free(l %p)
	call $sooth_trace_event(l $freefmt, l %adj)
	ret
}

function $sooth_oom_trap(l %n) {
@start
	call $dprintf(w 2, l $oomfmt, l %n, ...)
	call $exit(w 1)
	hlt
}

function $sooth_trace_event(l %fmt, l %n) {
@start
	%e =l call $getenv(l $tracenv)
	%unset =w ceql %e, 0
	jnz %unset, @off, @set
@set
	%c =w loadub %e
	jnz %c, @on, @off
@on
	call $printf(l %fmt, l %n, ...)
	ret
@off
	ret
}
