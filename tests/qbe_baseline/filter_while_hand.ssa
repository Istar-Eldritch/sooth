export function l $fixpoint__m0(l %v0) {
@start
	jmp @blk1
@blk1
	%v1 =l phi @start %v0, @blk5 %v13
	%v2 =l copy 5
	%v3 =w csltl %v1, %v2
	jnz %v3, @blk2, @blk3
@blk2
	%v6 =w copy 1
	jmp @blk4
@blk3
	%v7 =w copy 0
	jmp @blk4
@blk4
	%v8 =w phi @blk2 %v6, @blk3 %v7
	%v11 =w copy %v8
	jnz %v11, @blk5, @blk6
@blk5
	%v12 =l copy 1
	%v13 =l add %v1, %v12
	jmp @blk1
@blk6
	jmp @blk7
@blk7
	ret %v1
}

export function $sooth_main() {
@start
	%v0 =:arr_0 call $scores__m0()
	%v1 =l copy 0
	%v2 =l copy 5
	%v4 =l copy 0
	jmp @blk1
@blk1
	%v5 =l phi @start %v1, @blk15 %v44
	%v6 =l phi @start %v4, @blk15 %v46
	%v7 =l phi @start %v2, @blk15 %v7
	%v8 =w csltl %v6, %v7
	jnz %v8, @blk2, @blk3
@blk2
	%v11 =w copy 1
	jmp @blk4
@blk3
	%v12 =w copy 0
	jmp @blk4
@blk4
	%v13 =w phi @blk2 %v11, @blk3 %v12
	%v16 =w copy %v13
	jnz %v16, @blk5, @blk6
@blk5
	%v17 =l add %v0, 0
	%v18 =l copy %v6
	%v19 =l copy 5
	%v20 =w cultl %v18, %v19
	jnz %v20, @blk8, @blk9
@blk9
	%v21 =l copy 25
	%v22 =l copy 5
	call $sooth_oob_trap(l %v21, l %v18, l %v22)
	jmp @blk8
@blk8
	%eoff0 =l mul %v18, 8
	%v23 =l add %v17, %eoff0
	%v24 =l loadl %v23
	%v25 =l copy 4
	%v26 =w csgtl %v24, %v25
	jnz %v26, @blk10, @blk11
@blk10
	%v29 =w copy 1
	jmp @blk12
@blk11
	%v30 =w copy 0
	jmp @blk12
@blk12
	%v31 =w phi @blk10 %v29, @blk11 %v30
	%v34 =w copy %v31
	jnz %v34, @blk13, @blk14
@blk13
	%v35 =l add %v0, 0
	%v36 =l copy %v5
	%v37 =l copy 5
	%v38 =w cultl %v36, %v37
	jnz %v38, @blk16, @blk17
@blk17
	%v39 =l copy 26
	%v40 =l copy 5
	call $sooth_oob_trap(l %v39, l %v36, l %v40)
	jmp @blk16
@blk16
	%eoff1 =l mul %v36, 8
	%v41 =l add %v35, %eoff1
	storel %v24, %v41
	%v42 =l copy 1
	%v43 =l add %v5, %v42
	jmp @blk15
@blk14
	jmp @blk15
@blk15
	%v44 =l phi @blk16 %v43, @blk14 %v5
	%v45 =l copy 1
	%v46 =l add %v6, %v45
	jmp @blk1
@blk6
