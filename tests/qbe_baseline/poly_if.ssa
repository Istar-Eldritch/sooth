data $fmt = { b "%ld\n", b 0 }
data $ufmt = { b "%lu\n", b 0 }
data $ffmt = { b "%g\n", b 0 }
data $sfmt = { b "%s", b 0 }
data $oobfmt = { b "sooth: array index out of range (line %ld)\n  index %ld is out of bounds for length %ld\n", b 0 }
data $allocfmt = { b "alloc %ld\n", b 0 }
data $freefmt = { b "free %ld\n", b 0 }
data $tracenv = { b "SOOTH_TRACE_ALLOC", b 0 }
data $oomfmt = { b "sooth: out of memory (allocation of %ld bytes failed)\n", b 0 }
data $strfmt = { b "%.*s", b 0 }

export function $sooth_main() {
@start
	%v0 =l copy 2
	%v1 =l copy 5
	%v2 =l copy 9
	%v3 =w call $sooth_mono_gt__m3__t0_i64(l %v0, l %v1)
	%v6 =w copy %v3
	jnz %v6, @blk1, @blk2
@blk1
	%v7 =w call $sooth_mono_gt__m3__t0_i64(l %v0, l %v2)
	%v10 =w copy %v7
	jnz %v10, @blk4, @blk5
@blk4
	jmp @blk6
@blk5
	jmp @blk6
@blk6
	%v11 =l phi @blk4 %v0, @blk5 %v2
	jmp @blk3
@blk2
	%v12 =w call $sooth_mono_gt__m3__t0_i64(l %v1, l %v2)
	%v15 =w copy %v12
	jnz %v15, @blk7, @blk8
@blk7
	jmp @blk9
@blk8
	jmp @blk9
@blk9
	%v16 =l phi @blk7 %v1, @blk8 %v2
	jmp @blk3
@blk3
	%v17 =l phi @blk6 %v11, @blk9 %v16
	call $printf(l $fmt, l %v17, ...)
	%v18 =d copy d_2
	%v19 =d copy d_5
	%v20 =d copy d_9
	%v21 =w call $sooth_mono_gt__m3__t0_f64(d %v18, d %v19)
	%v24 =w copy %v21
	jnz %v24, @blk10, @blk11
@blk10
	%v25 =w call $sooth_mono_gt__m3__t0_f64(d %v18, d %v20)
	%v28 =w copy %v25
	jnz %v28, @blk13, @blk14
@blk13
	jmp @blk15
@blk14
	jmp @blk15
@blk15
	%v29 =d phi @blk13 %v18, @blk14 %v20
	jmp @blk12
@blk11
	%v30 =w call $sooth_mono_gt__m3__t0_f64(d %v19, d %v20)
	%v33 =w copy %v30
	jnz %v33, @blk16, @blk17
@blk16
	jmp @blk18
@blk17
	jmp @blk18
@blk18
	%v34 =d phi @blk16 %v19, @blk17 %v20
	jmp @blk12
@blk12
	%v35 =d phi @blk15 %v29, @blk18 %v34
	call $printf(l $ffmt, d %v35, ...)
	ret
}

export function w $sooth_mono_gt__m3__t0_f64(d %v0, d %v1) {
@start
	%cmp0 =w ceqd %v1, %v0
	%cmp1 =w cod %v1, %v0
	%v2 =w and %cmp0, %cmp1
	jnz %v2, @blk1, @blk2
@blk1
	%v5 =w copy 1
	jmp @blk3
@blk2
	%v6 =w cgtd %v0, %v1
	jnz %v6, @blk4, @blk5
@blk4
	%v9 =w copy 0
	jmp @blk6
@blk5
	%v10 =w cgtd %v1, %v0
	jnz %v10, @blk7, @blk8
@blk7
	%v13 =w copy 2
	jmp @blk9
@blk8
	%v14 =w copy 2
	jmp @blk9
@blk9
	%v15 =w phi @blk7 %v13, @blk8 %v14
	jmp @blk6
@blk6
	%v16 =w phi @blk4 %v9, @blk9 %v15
	jmp @blk3
@blk3
	%v17 =w phi @blk1 %v5, @blk6 %v16
	%v21 =w copy 0
	%v22 =w ceqw %v17, %v21
	jnz %v22, @blk10, @blk13
@blk13
	%v23 =w copy 1
	%v24 =w ceqw %v17, %v23
	jnz %v24, @blk11, @blk12
@blk10
	%v25 =w copy 1
	jmp @blk14
@blk11
	%v26 =w copy 0
	jmp @blk14
@blk12
	%v27 =w copy 0
	jmp @blk14
@blk14
	%v28 =w phi @blk10 %v25, @blk11 %v26, @blk12 %v27
	ret %v28
}

export function w $sooth_mono_gt__m3__t0_i64(l %v0, l %v1) {
@start
	%v2 =w csltl %v1, %v0
	jnz %v2, @blk1, @blk2
@blk1
	%v5 =w copy 0
	jmp @blk3
@blk2
	%v6 =w csgtl %v1, %v0
	jnz %v6, @blk4, @blk5
@blk4
	%v9 =w copy 2
	jmp @blk6
@blk5
	%v10 =w copy 1
	jmp @blk6
@blk6
	%v11 =w phi @blk4 %v9, @blk5 %v10
	jmp @blk3
@blk3
	%v12 =w phi @blk1 %v5, @blk6 %v11
	%v16 =w copy 0
	%v17 =w ceqw %v12, %v16
	jnz %v17, @blk7, @blk10
@blk10
	%v18 =w copy 1
	%v19 =w ceqw %v12, %v18
	jnz %v19, @blk8, @blk9
@blk7
	%v20 =w copy 1
	jmp @blk11
@blk8
	%v21 =w copy 0
	jmp @blk11
@blk9
	%v22 =w copy 0
	jmp @blk11
@blk11
	%v23 =w phi @blk7 %v20, @blk8 %v21, @blk9 %v22
	ret %v23
}

function $sooth_oob_trap(l %line, l %idx, l %len) {
@start
	call $dprintf(w 2, l $oobfmt, l %line, l %idx, l %len, ...)
	call $exit(w 1)
	hlt
}

function l $sooth_alloc(l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	%p =l call $malloc(l %adj)
	%isnull =w ceql %p, 0
	jnz %isnull, @oom, @ok
@oom
	call $sooth_oom_trap(l %adj)
	hlt
@ok
	call $sooth_trace_event(l $allocfmt, l %adj)
	ret %p
}

function $sooth_free(l %p, l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	call $free(l %p)
	call $sooth_trace_event(l $freefmt, l %adj)
	ret
}

function $sooth_oom_trap(l %n) {
@start
	call $dprintf(w 2, l $oomfmt, l %n, ...)
	call $exit(w 1)
	hlt
}

function $sooth_trace_event(l %fmt, l %n) {
@start
	%e =l call $getenv(l $tracenv)
	%unset =w ceql %e, 0
	jnz %unset, @off, @set
@set
	%c =w loadub %e
	jnz %c, @on, @off
@on
	call $printf(l %fmt, l %n, ...)
	ret
@off
	ret
}
