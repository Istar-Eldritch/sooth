data $fmt = { b "%ld\n", b 0 }
data $ufmt = { b "%lu\n", b 0 }
data $ffmt = { b "%g\n", b 0 }
data $sfmt = { b "%s", b 0 }
data $oobfmt = { b "sooth: array index out of range (line %ld)\n  index %ld is out of bounds for length %ld\n", b 0 }
data $allocfmt = { b "alloc %ld\n", b 0 }
data $freefmt = { b "free %ld\n", b 0 }
data $tracenv = { b "SOOTH_TRACE_ALLOC", b 0 }
data $oomfmt = { b "sooth: out of memory (allocation of %ld bytes failed)\n", b 0 }
data $strfmt = { b "%.*s", b 0 }

export function l $gcd__m0(l %v0, l %v1) {
@start
	jmp @blk1
@blk1
	%v2 =l phi @start %v0, @blk14 %v3
	%v3 =l phi @start %v1, @blk14 %v30
	%v4 =l copy 0
	%v5 =w csltl %v3, %v4
	jnz %v5, @blk2, @blk3
@blk2
	%v8 =w copy 0
	jmp @blk4
@blk3
	%v9 =w csgtl %v3, %v4
	jnz %v9, @blk5, @blk6
@blk5
	%v12 =w copy 2
	jmp @blk7
@blk6
	%v13 =w copy 1
	jmp @blk7
@blk7
	%v14 =w phi @blk5 %v12, @blk6 %v13
	jmp @blk4
@blk4
	%v15 =w phi @blk2 %v8, @blk7 %v14
	%v19 =w copy 0
	%v20 =w ceqw %v15, %v19
	jnz %v20, @blk8, @blk11
@blk11
	%v21 =w copy 1
	%v22 =w ceqw %v15, %v21
	jnz %v22, @blk9, @blk10
@blk8
	%v23 =w copy 0
	jmp @blk12
@blk9
	%v24 =w copy 1
	jmp @blk12
@blk10
	%v25 =w copy 0
	jmp @blk12
@blk12
	%v26 =w phi @blk8 %v23, @blk9 %v24, @blk10 %v25
	%v29 =w copy %v26
	jnz %v29, @blk13, @blk14
@blk13
	jmp @blk15
@blk14
	%v30 =l rem %v2, %v3
	jmp @blk1
@blk15
	ret %v2
}

export function $sooth_main() {
@start
	%v0 =l copy 10
	%v1 =l copy 15
	%v2 =l call $gcd__m0(l %v0, l %v1)
	call $printf(l $fmt, l %v2, ...)
	ret
}

function $sooth_oob_trap(l %line, l %idx, l %len) {
@start
	call $dprintf(w 2, l $oobfmt, l %line, l %idx, l %len, ...)
	call $exit(w 1)
	hlt
}

function l $sooth_alloc(l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	%p =l call $malloc(l %adj)
	%isnull =w ceql %p, 0
	jnz %isnull, @oom, @ok
@oom
	call $sooth_oom_trap(l %adj)
	hlt
@ok
	call $sooth_trace_event(l $allocfmt, l %adj)
	ret %p
}

function $sooth_free(l %p, l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	call $free(l %p)
	call $sooth_trace_event(l $freefmt, l %adj)
	ret
}

function $sooth_oom_trap(l %n) {
@start
	call $dprintf(w 2, l $oomfmt, l %n, ...)
	call $exit(w 1)
	hlt
}

function $sooth_trace_event(l %fmt, l %n) {
@start
	%e =l call $getenv(l $tracenv)
	%unset =w ceql %e, 0
	jnz %unset, @off, @set
@set
	%c =w loadub %e
	jnz %c, @on, @off
@on
	call $printf(l %fmt, l %n, ...)
	ret
@off
	ret
}
