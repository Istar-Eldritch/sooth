data $fmt = { b "%ld\n", b 0 }
data $ufmt = { b "%lu\n", b 0 }
data $ffmt = { b "%g\n", b 0 }
data $sfmt = { b "%s", b 0 }
data $oobfmt = { b "sooth: array index out of range (line %ld)\n  index %ld is out of bounds for length %ld\n", b 0 }
data $allocfmt = { b "alloc %ld\n", b 0 }
data $freefmt = { b "free %ld\n", b 0 }
data $tracenv = { b "SOOTH_TRACE_ALLOC", b 0 }
data $oomfmt = { b "sooth: out of memory (allocation of %ld bytes failed)\n", b 0 }
data $strfmt = { b "%.*s", b 0 }

export function l $sign__m0(l %v0) {
@start
	%v1 =l copy 0
	%v2 =w csltl %v1, %v0
	jnz %v2, @blk1, @blk2
@blk1
	%v5 =w copy 0
	jmp @blk3
@blk2
	%v6 =w csgtl %v1, %v0
	jnz %v6, @blk4, @blk5
@blk4
	%v9 =w copy 2
	jmp @blk6
@blk5
	%v10 =w copy 1
	jmp @blk6
@blk6
	%v11 =w phi @blk4 %v9, @blk5 %v10
	jmp @blk3
@blk3
	%v12 =w phi @blk1 %v5, @blk6 %v11
	%v16 =w copy 0
	%v17 =w ceqw %v12, %v16
	jnz %v17, @blk7, @blk10
@blk10
	%v18 =w copy 1
	%v19 =w ceqw %v12, %v18
	jnz %v19, @blk8, @blk9
@blk7
	%v20 =w copy 1
	jmp @blk11
@blk8
	%v21 =w copy 0
	jmp @blk11
@blk9
	%v22 =w copy 0
	jmp @blk11
@blk11
	%v23 =w phi @blk7 %v20, @blk8 %v21, @blk9 %v22
	%v26 =w copy %v23
	jnz %v26, @blk12, @blk13
@blk12
	%v27 =l copy 1
	jmp @blk14
@blk13
	%v28 =l copy 0
	jmp @blk14
@blk14
	%v29 =l phi @blk12 %v27, @blk13 %v28
	ret %v29
}

export function $sooth_main() {
@start
	%v0 =l copy -7
	%v1 =l call $sign__m0(l %v0)
	call $printf(l $fmt, l %v1, ...)
	ret
}

function $sooth_oob_trap(l %line, l %idx, l %len) {
@start
	call $dprintf(w 2, l $oobfmt, l %line, l %idx, l %len, ...)
	call $exit(w 1)
	hlt
}

function l $sooth_alloc(l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	%p =l call $malloc(l %adj)
	%isnull =w ceql %p, 0
	jnz %isnull, @oom, @ok
@oom
	call $sooth_oom_trap(l %adj)
	hlt
@ok
	call $sooth_trace_event(l $allocfmt, l %adj)
	ret %p
}

function $sooth_free(l %p, l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	call $free(l %p)
	call $sooth_trace_event(l $freefmt, l %adj)
	ret
}

function $sooth_oom_trap(l %n) {
@start
	call $dprintf(w 2, l $oomfmt, l %n, ...)
	call $exit(w 1)
	hlt
}

function $sooth_trace_event(l %fmt, l %n) {
@start
	%e =l call $getenv(l $tracenv)
	%unset =w ceql %e, 0
	jnz %unset, @off, @set
@set
	%c =w loadub %e
	jnz %c, @on, @off
@on
	call $printf(l %fmt, l %n, ...)
	ret
@off
	ret
}
