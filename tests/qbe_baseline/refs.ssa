export function $push.2d.byte(l %v0, w %v1) {
@start
	%v2 =l add %v0, 8
	%v3 =l loadl %v2
	%v4 =l add %v0, 0
	%v5 =l loadl %v4
	%v6 =l copy 64
	%v7 =w cultl %v3, %v6
	jnz %v7, @blk1, @blk2
@blk2
	%v8 =l copy 10
	%v9 =l copy 64
	call $sooth_oob_trap(l %v8, l %v3, l %v9)
	jmp @blk1
@blk1
	%eoff0 =l mul %v3, 1
	%v10 =l add %v5, %eoff0
	storeb %v1, %v10
	%v11 =l add %v0, 8
	%v12 =l copy 1
	%v13 =l loadl %v11
	%v14 =l add %v13, %v12
	storel %v14, %v11
	ret
}

export function w $byte.2d.at(l %v0, l %v1) {
@start
	%v2 =l add %v0, 0
	%v3 =l loadl %v2
	%v4 =l copy 64
	%v5 =w cultl %v1, %v4
	jnz %v5, @blk1, @blk2
@blk2
	%v6 =l copy 15
	%v7 =l copy 64
	call $sooth_oob_trap(l %v6, l %v1, l %v7)
	jmp @blk1
@blk1
	%eoff0 =l mul %v1, 1
	%v8 =l add %v3, %eoff0
	%v9 =w loadub %v8
	ret %v9
}

export function $copy.2d.byte(l %v0, l %v1, l %v2) {
@start
	%v3 =w call $byte.2d.at(l %v1, l %v2)
	call $push.2d.byte(l %v0, w %v3)
	ret
}

export function $sooth_main() {
@start
	%v0 =:Buf call $new()
	%v1 =:Buf call $new()
	%v2 =l add %v0, 0
	%v3 =l copy 72
	%v4 =w and %v3, 255
	call $push.2d.byte(l %v2, w %v4)
	%v5 =l add %v1, 0
	%v6 =l copy 90
	%v7 =w and %v6, 255
	call $push.2d.byte(l %v5, w %v7)
	%v8 =l add %v0, 0
	%v9 =l add %v1, 0
	%v10 =l copy 0
	call $copy.2d.byte(l %v8, l %v9, l %v10)
	%v11 =l add %v0, 0
	%v12 =l copy 0
	%v13 =w call $byte.2d.at(l %v11, l %v12)
	%pw0 =l extuw %v13
	call $printf(l $ufmt, l %pw0, ...)
	%v14 =l add %v0, 0
	%v15 =l copy 1
	%v16 =w call $byte.2d.at(l %v14, l %v15)
	%pw1 =l extuw %v16
	call $printf(l $ufmt, l %pw1, ...)
	%v17 =l add %v0, 0
	%v18 =l add %v17, 8
	%v19 =l loadl %v18
	call $printf(l $ufmt, l %v19, ...)
	call $sooth_struct_drop_0(:Buf %v0)
	call $sooth_struct_drop_0(:Buf %v1)
	%v20 =l copy 10
	%v21 =l alloc8 24
	%v22 =w copy 0
	%v23 =l add %v21, 0
	storew %v22, %v23
	%v24 =:List call $build(l %v20, :List %v21)
	%v25 =l add %v24, 0
	call $walk(l %v25)
	%v26 =:Popped call $pop(:List %v24)
	%v27 =l add %v26, 0
	%v28 =l add %v26, 24
	%v29 =l loadl %v28
	call $printf(l $fmt, l %v29, ...)
	call $sooth_enum_drop_1(:List %v27)
	ret
}

export function :List $push.2d.front(:List %v0, l %v1) {
@start
	%v2 =l copy 24
	%v3 =l call $sooth_alloc(l %v2)
	blit %v0, %v3, 24
	%v4 =l alloc8 24
	%v5 =w copy 1
	%v6 =l add %v4, 0
	storew %v5, %v6
	%v7 =l add %v4, 8
	storel %v1, %v7
	%v8 =l add %v4, 16
	storel %v3, %v8
	ret %v4
}

export function :List $build(l %v0, :List %v1) {
@start
	%v3 =l alloc8 24
	%v4 =l alloc8 24
	blit %v1, %v3, 24
	jmp @blk1
@blk1
	%v2 =l phi @start %v0, @blk3 %v8
	%v5 =l copy 0
	%v6 =w ceql %v2, %v5
	jnz %v6, @blk2, @blk3
@blk2
	jmp @blk4
@blk3
	%v7 =l copy 1
	%v8 =l sub %v2, %v7
	%v9 =:List call $push.2d.front(:List %v3, l %v2)
	blit %v9, %v4, 24
	blit %v4, %v3, 24
	jmp @blk1
@blk4
	ret %v3
}

export function :Popped $pop(:List %v0) {
@start
	%v2 =l add %v0, 0
	%v1 =w loadw %v2
	%v3 =w copy 0
	%v4 =w ceqw %v1, %v3
	jnz %v4, @blk1, @blk2
@blk1
	%v5 =l alloc8 24
	%v6 =w copy 0
	%v7 =l add %v5, 0
	storew %v6, %v7
	%v8 =l copy 0
	%v9 =l alloc8 32
	%v10 =l add %v9, 0
	blit %v5, %v10, 24
	%v11 =l add %v9, 24
	storel %v8, %v11
	jmp @blk3
@blk2
	%v12 =l add %v0, 8
	%v13 =l loadl %v12
	%v14 =l add %v0, 16
	%v15 =l loadl %v14
	%v16 =l alloc8 24
	blit %v15, %v16, 24
	%v17 =l copy 24
	call $sooth_free(l %v15, l %v17)
	%v18 =l alloc8 32
	%v19 =l add %v18, 0
	blit %v16, %v19, 24
	%v20 =l add %v18, 24
	storel %v13, %v20
	jmp @blk3
@blk3
	%v21 =l phi @blk1 %v9, @blk2 %v18
	ret %v21
}

export function $walk(l %v0) {
@start
	jmp @blk1
@blk1
	%v1 =l phi @start %v0, @blk3 %v11
	%v3 =l add %v1, 0
	%v2 =w loadw %v3
	%v4 =w copy 0
	%v5 =w ceqw %v2, %v4
	jnz %v5, @blk2, @blk3
@blk2
	jmp @blk4
@blk3
	%v6 =l add %v1, 8
	%v7 =l add %v1, 16
	%v8 =l copy 1
	%v9 =l loadl %v6
	%v10 =l add %v9, %v8
	storel %v10, %v6
	%v11 =l loadl %v7
	jmp @blk1
@blk4
	ret
}

export function $sooth_struct_drop_0(:Buf %v0) {
@start
	%v1 =l add %v0, 0
	%v2 =l loadl %v1
	call $sooth_cell_drop_0(l %v2)
	ret
}

export function $sooth_struct_drop_1(:Popped %v0) {
@start
	%v1 =l add %v0, 0
	call $sooth_enum_drop_1(:List %v1)
	ret
}

export function $sooth_enum_drop_1(:List %v0) {
@start
	%v8 =l alloc8 24
	jmp @blk1
@blk1
	%v1 =l phi @start %v0, @blk3 %v8
	%v3 =l add %v1, 0
	%v2 =w loadw %v3
	%v4 =w copy 0
	%v5 =w ceqw %v2, %v4
	jnz %v5, @blk2, @blk3
@blk2
	ret
@blk3
	%v6 =l add %v1, 16
	%v7 =l loadl %v6
	blit %v7, %v8, 24
	%v9 =l copy 24
	call $sooth_free(l %v7, l %v9)
	jmp @blk1
}

export function $sooth_cell_drop_0(l %v0) {
@start
	%v1 =l copy 64
	call $sooth_free(l %v0, l %v1)
	ret
}

export function $sooth_cell_drop_1(l %v0) {
@start
	%v1 =l alloc8 24
	blit %v0, %v1, 24
	%v2 =l copy 24
	call $sooth_free(l %v0, l %v2)
	call $sooth_enum_drop_1(:List %v1)
	ret
}

function $sooth_oob_trap(l %line, l %idx, l %len) {
@start
	call $dprintf(w 2, l $oobfmt, l %line, l %idx, l %len, ...)
	call $exit(w 1)
	hlt
}

function l $sooth_alloc(l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	%p =l call $malloc(l %adj)
	%isnull =w ceql %p, 0
	jnz %isnull, @oom, @ok
@oom
	call $sooth_oom_trap(l %adj)
	hlt
@ok
	call $sooth_trace_event(l $allocfmt, l %adj)
	ret %p
}

function $sooth_free(l %p, l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	call $free(l %p)
	call $sooth_trace_event(l $freefmt, l %adj)
	ret
}

function $sooth_oom_trap(l %n) {
@start
	call $dprintf(w 2, l $oomfmt, l %n, ...)
	call $exit(w 1)
	hlt
}

function $sooth_trace_event(l %fmt, l %n) {
@start
	%e =l call $getenv(l $tracenv)
	%unset =w ceql %e, 0
	jnz %unset, @off, @set
@set
	%c =w loadub %e
	jnz %c, @on, @off
@on
	call $printf(l %fmt, l %n, ...)
	ret
@off
	ret
}
