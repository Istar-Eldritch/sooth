data $fmt = { b "%ld\n", b 0 }
data $ufmt = { b "%lu\n", b 0 }
data $ffmt = { b "%g\n", b 0 }
data $sfmt = { b "%s", b 0 }
data $true_str = { b "true\n", b 0 }
data $false_str = { b "false\n", b 0 }
data $boolstrs = { l $false_str, l $true_str }
data $oobfmt = { b "sooth: array index out of range (line %ld)\n  index %ld is out of bounds for length %ld\n", b 0 }
data $allocfmt = { b "alloc %ld\n", b 0 }
data $freefmt = { b "free %ld\n", b 0 }
data $tracenv = { b "SOOTH_TRACE_ALLOC", b 0 }
data $oomfmt = { b "sooth: out of memory (allocation of %ld bytes failed)\n", b 0 }
data $strfmt = { b "%.*s", b 0 }
type :arr_0 = align 8 { b 128 }
type :Stack = { :arr_0, l }
type :__ret_1 = { :Stack, l }

export function :Stack $empty__m0() {
@start
	%v0 =l copy 0
	%v1 =l copy 16
	%v2 =l alloc8 128
	%v3 =l copy 0
	jmp @blk1
@blk1
	%v4 =l phi @start %v3, @blk2 %v9
	%v5 =l copy 16
	%v6 =w csltl %v4, %v5
	jnz %v6, @blk2, @blk3
@blk2
	%eoff0 =l mul %v4, 8
	%v7 =l add %v2, %eoff0
	storel %v0, %v7
	%v8 =l copy 1
	%v9 =l add %v4, %v8
	jmp @blk1
@blk3
	%v10 =l copy 0
	%v11 =l copy %v10
	%v12 =l alloc8 136
	%v13 =l add %v12, 0
	blit %v2, %v13, 128
	%v14 =l add %v12, 128
	storel %v11, %v14
	ret %v12
}

export function :Stack $push__m0(:Stack %v0, l %v1) {
@start
	%v2 =l add %v0, 0
	%v3 =l add %v2, 128
	%v4 =l loadl %v3
	%v5 =l add %v0, 0
	%v6 =l add %v5, 0
	%v7 =l copy 16
	%v8 =w cultl %v4, %v7
	jnz %v8, @blk1, @blk2
@blk2
	%v9 =l copy 24
	%v10 =l copy 16
	call $sooth_oob_trap(l %v9, l %v4, l %v10)
	jmp @blk1
@blk1
	%eoff0 =l mul %v4, 8
	%v11 =l add %v6, %eoff0
	storel %v1, %v11
	%v12 =l add %v0, 0
	%v13 =l add %v12, 128
	%v14 =l loadl %v13
	%v15 =l copy 1
	%v16 =l add %v14, %v15
	%v17 =l add %v0, 128
	storel %v16, %v17
	ret %v0
}

export function :__ret_1 $pop__m0(:Stack %v0) {
@start
	%v1 =l add %v0, 0
	%v2 =l add %v1, 128
	%v3 =l loadl %v2
	%v4 =l copy 1
	%v5 =l sub %v3, %v4
	%v6 =l add %v0, 0
	%v7 =l add %v6, 0
	%v8 =l copy 16
	%v9 =w cultl %v5, %v8
	jnz %v9, @blk1, @blk2
@blk2
	%v10 =l copy 31
	%v11 =l copy 16
	call $sooth_oob_trap(l %v10, l %v5, l %v11)
	jmp @blk1
@blk1
	%eoff0 =l mul %v5, 8
	%v12 =l add %v7, %eoff0
	%v13 =l loadl %v12
	%v14 =l add %v0, 128
	storel %v5, %v14
	%v15 =l alloc8 144
	%v16 =l add %v15, 0
	blit %v0, %v16, 136
	%v17 =l add %v15, 136
	storel %v13, %v17
	ret %v15
}

export function :__ret_1 $peek__m0(:Stack %v0) {
@start
	%v1 =l add %v0, 0
	%v2 =l add %v1, 128
	%v3 =l loadl %v2
	%v4 =l copy 1
	%v5 =l sub %v3, %v4
	%v6 =l add %v0, 0
	%v7 =l add %v6, 0
	%v8 =l copy 16
	%v9 =w cultl %v5, %v8
	jnz %v9, @blk1, @blk2
@blk2
	%v10 =l copy 37
	%v11 =l copy 16
	call $sooth_oob_trap(l %v10, l %v5, l %v11)
	jmp @blk1
@blk1
	%eoff0 =l mul %v5, 8
	%v12 =l add %v7, %eoff0
	%v13 =l loadl %v12
	%v14 =l alloc8 144
	%v15 =l add %v14, 0
	blit %v0, %v15, 136
	%v16 =l add %v14, 136
	storel %v13, %v16
	ret %v14
}

export function $sooth_main() {
@start
	%v0 =:Stack call $empty__m0()
	%v1 =l copy 1
	%v2 =:Stack call $push__m0(:Stack %v0, l %v1)
	%v3 =l copy 2
	%v4 =:Stack call $push__m0(:Stack %v2, l %v3)
	%v5 =l copy 3
	%v6 =:Stack call $push__m0(:Stack %v4, l %v5)
	%v7 =:__ret_1 call $peek__m0(:Stack %v6)
	%v8 =l add %v7, 0
	%v9 =l add %v7, 136
	%v10 =l loadl %v9
	call $printf(l $fmt, l %v10, ...)
	%v11 =:__ret_1 call $pop__m0(:Stack %v8)
	%v12 =l add %v11, 0
	%v13 =l add %v11, 136
	%v14 =l loadl %v13
	call $printf(l $fmt, l %v14, ...)
	%v15 =:__ret_1 call $pop__m0(:Stack %v12)
	%v16 =l add %v15, 0
	%v17 =l add %v15, 136
	%v18 =l loadl %v17
	call $printf(l $fmt, l %v18, ...)
	%v19 =:__ret_1 call $peek__m0(:Stack %v16)
	%v20 =l add %v19, 0
	%v21 =l add %v19, 136
	%v22 =l loadl %v21
	call $printf(l $fmt, l %v22, ...)
	%v23 =l add %v20, 0
	%v24 =l alloc8 128
	blit %v23, %v24, 128
	%v25 =l copy 16
	call $printf(l $ufmt, l %v25, ...)
	ret
}

function $sooth_oob_trap(l %line, l %idx, l %len) {
@start
	call $dprintf(w 2, l $oobfmt, l %line, l %idx, l %len, ...)
	call $exit(w 1)
	hlt
}

function l $sooth_alloc(l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	%p =l call $malloc(l %adj)
	%isnull =w ceql %p, 0
	jnz %isnull, @oom, @ok
@oom
	call $sooth_oom_trap(l %adj)
	hlt
@ok
	call $sooth_trace_event(l $allocfmt, l %adj)
	ret %p
}

function $sooth_free(l %p, l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	call $free(l %p)
	call $sooth_trace_event(l $freefmt, l %adj)
	ret
}

function $sooth_oom_trap(l %n) {
@start
	call $dprintf(w 2, l $oomfmt, l %n, ...)
	call $exit(w 1)
	hlt
}

function $sooth_trace_event(l %fmt, l %n) {
@start
	%e =l call $getenv(l $tracenv)
	%unset =w ceql %e, 0
	jnz %unset, @off, @set
@set
	%c =w loadub %e
	jnz %c, @on, @off
@on
	call $printf(l %fmt, l %n, ...)
	ret
@off
	ret
}
