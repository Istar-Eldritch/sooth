type :arr_0 = align 8 { b 24 }
type :arr_1 = align 8 { b 72 }
type :Q0 = { l, l, l }

export function :Q0 $seed__m0() {
@start
	%v1 =l alloc8 24
	%v2 =l copy $seed__m0__quot0
	%v3 =l add %v1, 0
	storel %v2, %v3
	%v4 =l copy 0
	%v5 =l add %v1, 8
	storel %v4, %v5
	%v6 =l copy 0
	%v7 =l add %v1, 16
	storel %v6, %v7
	ret %v1
}

export function l $seed__m0__quot0(l %v0) {
@start
	%v1 =l copy 0
	ret %v1
}

export function $sooth_main() {
@start
	%v0 =l copy 7
	%v1 =l copy 3
	%v2 =l alloc8 24
	%v3 =l copy 0
	jmp @blk1
@blk1
	%v4 =l phi @start %v3, @blk2 %v9
	%v5 =l copy 3
	%v6 =w csltl %v4, %v5
	jnz %v6, @blk2, @blk3
@blk2
	%eoff0 =l mul %v4, 8
	%v7 =l add %v2, %eoff0
	storel %v0, %v7
	%v8 =l copy 1
	%v9 =l add %v4, %v8
	jmp @blk1
@blk3
	%v10 =l add %v2, 0
	%v11 =l copy 1
	%v12 =l copy %v11
	%v13 =l copy 3
	%v14 =w cultl %v12, %v13
	jnz %v14, @blk4, @blk5
@blk5
	%v15 =l copy 15
	%v16 =l copy 3
	call $sooth_oob_trap(l %v15, l %v12, l %v16)
	jmp @blk4
@blk4
	%eoff1 =l mul %v12, 8
	%v17 =l add %v10, %eoff1
	%v18 =l copy 8
	storel %v18, %v17
	%v19 =l add %v2, 0
	%v20 =l copy 2
	%v21 =l copy %v20
	%v22 =l copy 3
	%v23 =w cultl %v21, %v22
	jnz %v23, @blk6, @blk7
@blk7
	%v24 =l copy 16
	%v25 =l copy 3
	call $sooth_oob_trap(l %v24, l %v21, l %v25)
	jmp @blk6
@blk6
	%eoff2 =l mul %v21, 8
	%v26 =l add %v19, %eoff2
	%v27 =l copy 9
	storel %v27, %v26
	%v28 =l add %v2, 0
	%v29 =:Q0 call $seed__m0()
	%v30 =l copy 3
	%v31 =l alloc8 72
	%v32 =l copy 0
	jmp @blk8
@blk8
	%v33 =l phi @blk6 %v32, @blk9 %v38
	%v34 =l copy 3
	%v35 =w csltl %v33, %v34
	jnz %v35, @blk9, @blk10
@blk9
	%eoff3 =l mul %v33, 24
	%v36 =l add %v31, %eoff3
	blit %v29, %v36, 24
	%v37 =l copy 1
	%v38 =l add %v33, %v37
	jmp @blk8
@blk10
	%v39 =l add %v31, 0
	%v40 =l copy 0
	%v41 =l copy %v40
	%v42 =l copy 3
	%v43 =w cultl %v41, %v42
	jnz %v43, @blk11, @blk12
@blk12
	%v44 =l copy 19
	%v45 =l copy 3
	call $sooth_oob_trap(l %v44, l %v41, l %v45)
	jmp @blk11
@blk11
	%eoff4 =l mul %v41, 24
	%v46 =l add %v39, %eoff4
	%v48 =l alloc8 24
	%v49 =l copy $main__quot0
	%v50 =l add %v48, 0
	storel %v49, %v50
	%v51 =l add %v48, 8
	storel %v28, %v51
	%v52 =l copy 0
	%v53 =l add %v48, 16
	storel %v52, %v53
	blit %v48, %v46, 24
	%v54 =l add %v31, 0
	%v55 =l copy 1
	%v56 =l copy %v55
	%v57 =l copy 3
	%v58 =w cultl %v56, %v57
	jnz %v58, @blk13, @blk14
@blk14
	%v59 =l copy 20
	%v60 =l copy 3
	call $sooth_oob_trap(l %v59, l %v56, l %v60)
	jmp @blk13
@blk13
	%eoff5 =l mul %v56, 24
	%v61 =l add %v54, %eoff5
	%v63 =l alloc8 24
	%v64 =l copy $main__quot1
	%v65 =l add %v63, 0
	storel %v64, %v65
	%v66 =l add %v63, 8
	storel %v28, %v66
	%v67 =l copy 0
	%v68 =l add %v63, 16
	storel %v67, %v68
	blit %v63, %v61, 24
	%v69 =l add %v31, 0
	%v70 =l copy 2
	%v71 =l copy %v70
	%v72 =l copy 3
	%v73 =w cultl %v71, %v72
	jnz %v73, @blk15, @blk16
@blk16
	%v74 =l copy 21
	%v75 =l copy 3
	call $sooth_oob_trap(l %v74, l %v71, l %v75)
	jmp @blk15
@blk15
	%eoff6 =l mul %v71, 24
	%v76 =l add %v69, %eoff6
	%v78 =l alloc8 24
	%v79 =l copy $main__quot2
	%v80 =l add %v78, 0
	storel %v79, %v80
	%v81 =l add %v78, 8
	storel %v28, %v81
	%v82 =l copy 0
	%v83 =l add %v78, 16
	storel %v82, %v83
	blit %v78, %v76, 24
	%v84 =l add %v31, 0
	%v85 =l copy 0
	%eoff7 =l mul %v85, 24
	%v86 =l add %v84, %eoff7
	%v87 =l alloc8 24
	blit %v86, %v87, 24
	%v88 =l add %v87, 0
	%v89 =l loadl %v88
	%v90 =l add %v87, 8
	%v91 =l loadl %v90
	%v92 =l call %v89(l %v91)
	call $printf(l $fmt, l %v92, ...)
	%v93 =l add %v31, 0
	%v94 =l copy 1
	%eoff8 =l mul %v94, 24
	%v95 =l add %v93, %eoff8
	%v96 =l alloc8 24
	blit %v95, %v96, 24
	%v97 =l add %v96, 0
	%v98 =l loadl %v97
	%v99 =l add %v96, 8
	%v100 =l loadl %v99
	%v101 =l call %v98(l %v100)
	call $printf(l $fmt, l %v101, ...)
	%v102 =l add %v31, 0
	%v103 =l copy 2
	%eoff9 =l mul %v103, 24
	%v104 =l add %v102, %eoff9
	%v105 =l alloc8 24
	blit %v104, %v105, 24
	%v106 =l add %v105, 0
	%v107 =l loadl %v106
	%v108 =l add %v105, 8
	%v109 =l loadl %v108
	%v110 =l call %v107(l %v109)
	call $printf(l $fmt, l %v110, ...)
	ret
}

export function l $main__quot0(l %v0) {
@start
	%v1 =l copy 0
	%v2 =l copy %v1
	%v3 =l copy 3
	%v4 =w cultl %v2, %v3
	jnz %v4, @blk1, @blk2
@blk2
	%v5 =l copy 19
	%v6 =l copy 3
	call $sooth_oob_trap(l %v5, l %v2, l %v6)
	jmp @blk1
@blk1
	%eoff0 =l mul %v2, 8
	%v7 =l add %v0, %eoff0
	%v8 =l loadl %v7
	ret %v8
}

