@start
	%v1 =l copy 1
	%v2 =l copy %v1
	%v3 =l copy 3
	%v4 =w cultl %v2, %v3
	jnz %v4, @blk1, @blk2
@blk2
	%v5 =l copy 20
	%v6 =l copy 3
	call $sooth_oob_trap(l %v5, l %v2, l %v6)
