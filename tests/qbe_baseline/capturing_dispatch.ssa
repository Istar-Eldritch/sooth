export function l $main__quot0(l %v0) {
@start
	%v1 =l copy 0
	%v2 =l copy %v1
	%v3 =l copy 3
	%v4 =w cultl %v2, %v3
	jnz %v4, @blk1, @blk2
@blk2
	%v5 =l copy 17
	%v6 =l copy 3
	call $sooth_oob_trap(l %v5, l %v2, l %v6)
	jmp @blk1
@blk1
	%eoff0 =l mul %v2, 8
	%v7 =l add %v0, %eoff0
	%v8 =l loadl %v7
	ret %v8
}

