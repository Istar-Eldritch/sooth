data $fmt = { b "%ld\n", b 0 }
data $ufmt = { b "%lu\n", b 0 }
data $ffmt = { b "%g\n", b 0 }
data $sfmt = { b "%s", b 0 }
data $true_str = { b "true\n", b 0 }
data $false_str = { b "false\n", b 0 }
data $boolstrs = { l $false_str, l $true_str }
data $oobfmt = { b "sooth: array index out of range (line %ld)\n  index %ld is out of bounds for length %ld\n", b 0 }
data $allocfmt = { b "alloc %ld\n", b 0 }
data $freefmt = { b "free %ld\n", b 0 }
data $tracenv = { b "SOOTH_TRACE_ALLOC", b 0 }
data $oomfmt = { b "sooth: out of memory (allocation of %ld bytes failed)\n", b 0 }
data $strfmt = { b "%.*s", b 0 }
data $strb0 = { b 102, b 97, b 108, b 115, b 101, b 10, b 0 }
data $strd0 = { l $strb0, l 6 }
data $strb1 = { b 116, b 114, b 117, b 101, b 10, b 0 }
data $strd1 = { l $strb1, l 5 }

export function $.2e.(w %v0) {
@start
	%v1 =w copy 0
	%v2 =w ceqw %v0, %v1
	jnz %v2, @blk1, @blk2
@blk1
	%v3 =l copy $strd0
	%sptr0 =l loadl %v3
	%slena1 =l add %v3, 8
	%slen2 =l loadl %slena1
	call $printf(l $strfmt, l %slen2, l %sptr0, ...)
	jmp @blk3
@blk2
	%v4 =l copy $strd1
	%sptr3 =l loadl %v4
	%slena4 =l add %v4, 8
	%slen5 =l loadl %slena4
	call $printf(l $strfmt, l %slen5, l %sptr3, ...)
	jmp @blk3
@blk3
	ret
}

export function w $leap__m0(l %v0) {
@start
	%v1 =l copy 4
	%v2 =l rem %v0, %v1
	%v3 =l copy 0
	%v4 =w ceql %v2, %v3
	jnz %v4, @blk1, @blk2
@blk1
	%v7 =w copy 1
	jmp @blk3
@blk2
	%v8 =w copy 0
	jmp @blk3
@blk3
	%v9 =w phi @blk1 %v7, @blk2 %v8
	%v10 =l copy 100
	%v11 =l rem %v0, %v10
	%v12 =l copy 0
	%v13 =w ceql %v11, %v12
	jnz %v13, @blk4, @blk5
@blk4
	%v16 =w copy 1
	jmp @blk6
@blk5
	%v17 =w copy 0
	jmp @blk6
@blk6
	%v18 =w phi @blk4 %v16, @blk5 %v17
	%v19 =w copy 1
	%v20 =w xor %v18, %v19
	%v21 =w and %v9, %v20
	%v22 =l copy 400
	%v23 =l rem %v0, %v22
	%v24 =l copy 0
	%v25 =w ceql %v23, %v24
	jnz %v25, @blk7, @blk8
@blk7
	%v28 =w copy 1
	jmp @blk9
@blk8
	%v29 =w copy 0
	jmp @blk9
@blk9
	%v30 =w phi @blk7 %v28, @blk8 %v29
	%v31 =w or %v21, %v30
	ret %v31
}

export function $sooth_main() {
@start
	%v0 =l copy 2000
	%v1 =w call $leap__m0(l %v0)
	call $.2e.(w %v1)
	%v2 =l copy 1900
	%v3 =w call $leap__m0(l %v2)
	call $.2e.(w %v3)
	%v4 =l copy 2024
	%v5 =w call $leap__m0(l %v4)
	call $.2e.(w %v5)
	ret
}

function $sooth_oob_trap(l %line, l %idx, l %len) {
@start
	call $dprintf(w 2, l $oobfmt, l %line, l %idx, l %len, ...)
	call $exit(w 1)
	hlt
}

function l $sooth_alloc(l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	%p =l call $malloc(l %adj)
	%isnull =w ceql %p, 0
	jnz %isnull, @oom, @ok
@oom
	call $sooth_oom_trap(l %adj)
	hlt
@ok
	call $sooth_trace_event(l $allocfmt, l %adj)
	ret %p
}

function $sooth_free(l %p, l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	call $free(l %p)
	call $sooth_trace_event(l $freefmt, l %adj)
	ret
}

function $sooth_oom_trap(l %n) {
@start
	call $dprintf(w 2, l $oomfmt, l %n, ...)
	call $exit(w 1)
	hlt
}

function $sooth_trace_event(l %fmt, l %n) {
@start
	%e =l call $getenv(l $tracenv)
	%unset =w ceql %e, 0
	jnz %unset, @off, @set
@set
	%c =w loadub %e
	jnz %c, @on, @off
@on
	call $printf(l %fmt, l %n, ...)
	ret
@off
	ret
}
