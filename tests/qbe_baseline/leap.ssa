data $fmt = { b "%ld\n", b 0 }
data $ufmt = { b "%lu\n", b 0 }
data $ffmt = { b "%g\n", b 0 }
data $sfmt = { b "%s", b 0 }
data $oobfmt = { b "sooth: array index out of range (line %ld)\n  index %ld is out of bounds for length %ld\n", b 0 }
data $allocfmt = { b "alloc %ld\n", b 0 }
data $freefmt = { b "free %ld\n", b 0 }
data $tracenv = { b "SOOTH_TRACE_ALLOC", b 0 }
data $oomfmt = { b "sooth: out of memory (allocation of %ld bytes failed)\n", b 0 }
data $strfmt = { b "%.*s", b 0 }
data $strb0 = { b 70, b 97, b 108, b 115, b 101, b 10, b 0 }
data $strd0 = { l $strb0, l 6 }
data $strb1 = { b 84, b 114, b 117, b 101, b 10, b 0 }
data $strd1 = { l $strb1, l 5 }

export function w $leap__m0(l %v0) {
@start
	%v1 =l copy 4
	%v2 =l rem %v0, %v1
	%v3 =l copy 0
	%v4 =w call $sooth_mono_eq__m3__t0_i64(l %v2, l %v3)
	%v5 =l copy 100
	%v6 =l rem %v0, %v5
	%v7 =l copy 0
	%v8 =w call $sooth_mono_eq__m3__t0_i64(l %v6, l %v7)
	%v9 =w copy 1
	%v10 =w xor %v8, %v9
	%v11 =w and %v4, %v10
	%v12 =l copy 400
	%v13 =l rem %v0, %v12
	%v14 =l copy 0
	%v15 =w call $sooth_mono_eq__m3__t0_i64(l %v13, l %v14)
	%v16 =w or %v11, %v15
	ret %v16
}

export function $sooth_main() {
@start
	%v0 =l copy 2000
	%v1 =w call $leap__m0(l %v0)
	call $.2e.__m2(w %v1)
	%v2 =l copy 1900
	%v3 =w call $leap__m0(l %v2)
	call $.2e.__m2(w %v3)
	%v4 =l copy 2024
	%v5 =w call $leap__m0(l %v4)
	call $.2e.__m2(w %v5)
	ret
}

export function $.2e.__m2(w %v0) {
@start
	%v3 =w copy 0
	%v4 =w ceqw %v0, %v3
	jnz %v4, @blk1, @blk2
@blk1
	%v5 =l copy $strd0
	%sptr0 =l loadl %v5
	%slena1 =l add %v5, 8
	%slen2 =l loadl %slena1
	call $printf(l $strfmt, l %slen2, l %sptr0, ...)
	jmp @blk3
@blk2
	%v6 =l copy $strd1
	%sptr3 =l loadl %v6
	%slena4 =l add %v6, 8
	%slen5 =l loadl %slena4
	call $printf(l $strfmt, l %slen5, l %sptr3, ...)
	jmp @blk3
@blk3
	ret
}

export function w $sooth_mono_eq__m3__t0_i64(l %v0, l %v1) {
@start
	%v2 =w csltl %v0, %v1
	jnz %v2, @blk1, @blk2
@blk1
	%v5 =w copy 0
	jmp @blk3
@blk2
	%v6 =w csgtl %v0, %v1
	jnz %v6, @blk4, @blk5
@blk4
	%v9 =w copy 2
	jmp @blk6
@blk5
	%v10 =w copy 1
	jmp @blk6
@blk6
	%v11 =w phi @blk4 %v9, @blk5 %v10
	jmp @blk3
@blk3
	%v12 =w phi @blk1 %v5, @blk6 %v11
	%v16 =w copy 0
	%v17 =w ceqw %v12, %v16
	jnz %v17, @blk7, @blk10
@blk10
	%v18 =w copy 1
	%v19 =w ceqw %v12, %v18
	jnz %v19, @blk8, @blk9
@blk7
	%v20 =w copy 0
	jmp @blk11
@blk8
	%v21 =w copy 1
	jmp @blk11
@blk9
	%v22 =w copy 0
	jmp @blk11
@blk11
	%v23 =w phi @blk7 %v20, @blk8 %v21, @blk9 %v22
	ret %v23
}

function $sooth_oob_trap(l %line, l %idx, l %len) {
@start
	call $dprintf(w 2, l $oobfmt, l %line, l %idx, l %len, ...)
	call $exit(w 1)
	hlt
}

function l $sooth_alloc(l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	%p =l call $malloc(l %adj)
	%isnull =w ceql %p, 0
	jnz %isnull, @oom, @ok
@oom
	call $sooth_oom_trap(l %adj)
	hlt
@ok
	call $sooth_trace_event(l $allocfmt, l %adj)
	ret %p
}

function $sooth_free(l %p, l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	call $free(l %p)
	call $sooth_trace_event(l $freefmt, l %adj)
	ret
}

function $sooth_oom_trap(l %n) {
@start
	call $dprintf(w 2, l $oomfmt, l %n, ...)
	call $exit(w 1)
	hlt
}

function $sooth_trace_event(l %fmt, l %n) {
@start
	%e =l call $getenv(l $tracenv)
	%unset =w ceql %e, 0
	jnz %unset, @off, @set
@set
	%c =w loadub %e
	jnz %c, @on, @off
@on
	call $printf(l %fmt, l %n, ...)
	ret
@off
	ret
}
