data $fmt = { b "%ld\n", b 0 }
data $ufmt = { b "%lu\n", b 0 }
data $ffmt = { b "%g\n", b 0 }
data $sfmt = { b "%s", b 0 }
data $oobfmt = { b "sooth: array index out of range (line %ld)\n  index %ld is out of bounds for length %ld\n", b 0 }
data $allocfmt = { b "alloc %ld\n", b 0 }
data $freefmt = { b "free %ld\n", b 0 }
data $tracenv = { b "SOOTH_TRACE_ALLOC", b 0 }
data $oomfmt = { b "sooth: out of memory (allocation of %ld bytes failed)\n", b 0 }
data $strfmt = { b "%.*s", b 0 }
data $strb0 = { b 70, b 97, b 108, b 115, b 101, b 10, b 0 }
data $strd0 = { l $strb0, l 6 }
data $strb1 = { b 84, b 114, b 117, b 101, b 10, b 0 }
data $strd1 = { l $strb1, l 5 }

export function w $leap__m0(l %v0) {
@start
	%v1 =l copy 4
	%v2 =l rem %v0, %v1
	%v3 =l copy 0
	%v4 =w csltl %v2, %v3
	jnz %v4, @blk1, @blk2
@blk1
	%v7 =w copy 0
	jmp @blk3
@blk2
	%v8 =w csgtl %v2, %v3
	jnz %v8, @blk4, @blk5
@blk4
	%v11 =w copy 2
	jmp @blk6
@blk5
	%v12 =w copy 1
	jmp @blk6
@blk6
	%v13 =w phi @blk4 %v11, @blk5 %v12
	jmp @blk3
@blk3
	%v14 =w phi @blk1 %v7, @blk6 %v13
	%v18 =w copy 0
	%v19 =w ceqw %v14, %v18
	jnz %v19, @blk7, @blk10
@blk10
	%v20 =w copy 1
	%v21 =w ceqw %v14, %v20
	jnz %v21, @blk8, @blk9
@blk7
	%v22 =w copy 0
	jmp @blk11
@blk8
	%v23 =w copy 1
	jmp @blk11
@blk9
	%v24 =w copy 0
	jmp @blk11
@blk11
	%v25 =w phi @blk7 %v22, @blk8 %v23, @blk9 %v24
	%v26 =l copy 100
	%v27 =l rem %v0, %v26
	%v28 =l copy 0
	%v29 =w csltl %v27, %v28
	jnz %v29, @blk12, @blk13
@blk12
	%v32 =w copy 0
	jmp @blk14
@blk13
	%v33 =w csgtl %v27, %v28
	jnz %v33, @blk15, @blk16
@blk15
	%v36 =w copy 2
	jmp @blk17
@blk16
	%v37 =w copy 1
	jmp @blk17
@blk17
	%v38 =w phi @blk15 %v36, @blk16 %v37
	jmp @blk14
@blk14
	%v39 =w phi @blk12 %v32, @blk17 %v38
	%v43 =w copy 0
	%v44 =w ceqw %v39, %v43
	jnz %v44, @blk18, @blk21
@blk21
	%v45 =w copy 1
	%v46 =w ceqw %v39, %v45
	jnz %v46, @blk19, @blk20
@blk18
	%v47 =w copy 0
	jmp @blk22
@blk19
	%v48 =w copy 1
	jmp @blk22
@blk20
	%v49 =w copy 0
	jmp @blk22
@blk22
	%v50 =w phi @blk18 %v47, @blk19 %v48, @blk20 %v49
	%v51 =w copy 1
	%v52 =w xor %v50, %v51
	%v53 =w and %v25, %v52
	%v54 =l copy 400
	%v55 =l rem %v0, %v54
	%v56 =l copy 0
	%v57 =w csltl %v55, %v56
	jnz %v57, @blk23, @blk24
@blk23
	%v60 =w copy 0
	jmp @blk25
@blk24
	%v61 =w csgtl %v55, %v56
	jnz %v61, @blk26, @blk27
@blk26
	%v64 =w copy 2
	jmp @blk28
@blk27
	%v65 =w copy 1
	jmp @blk28
@blk28
	%v66 =w phi @blk26 %v64, @blk27 %v65
	jmp @blk25
@blk25
	%v67 =w phi @blk23 %v60, @blk28 %v66
	%v71 =w copy 0
	%v72 =w ceqw %v67, %v71
	jnz %v72, @blk29, @blk32
@blk32
	%v73 =w copy 1
	%v74 =w ceqw %v67, %v73
	jnz %v74, @blk30, @blk31
@blk29
	%v75 =w copy 0
	jmp @blk33
@blk30
	%v76 =w copy 1
	jmp @blk33
@blk31
	%v77 =w copy 0
	jmp @blk33
@blk33
	%v78 =w phi @blk29 %v75, @blk30 %v76, @blk31 %v77
	%v79 =w or %v53, %v78
	ret %v79
}

export function $sooth_main() {
@start
	%v0 =l copy 2000
	%v1 =w call $leap__m0(l %v0)
	call $.2e.__m2(w %v1)
	%v2 =l copy 1900
	%v3 =w call $leap__m0(l %v2)
	call $.2e.__m2(w %v3)
	%v4 =l copy 2024
	%v5 =w call $leap__m0(l %v4)
	call $.2e.__m2(w %v5)
	ret
}

export function $.2e.__m2(w %v0) {
@start
	%v3 =w copy 0
	%v4 =w ceqw %v0, %v3
	jnz %v4, @blk1, @blk2
@blk1
	%v5 =l copy $strd0
	%sptr0 =l loadl %v5
	%slena1 =l add %v5, 8
	%slen2 =l loadl %slena1
	call $printf(l $strfmt, l %slen2, l %sptr0, ...)
	jmp @blk3
@blk2
	%v6 =l copy $strd1
	%sptr3 =l loadl %v6
	%slena4 =l add %v6, 8
	%slen5 =l loadl %slena4
	call $printf(l $strfmt, l %slen5, l %sptr3, ...)
	jmp @blk3
@blk3
	ret
}

function $sooth_oob_trap(l %line, l %idx, l %len) {
@start
	call $dprintf(w 2, l $oobfmt, l %line, l %idx, l %len, ...)
	call $exit(w 1)
	hlt
}

function l $sooth_alloc(l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	%p =l call $malloc(l %adj)
	%isnull =w ceql %p, 0
	jnz %isnull, @oom, @ok
@oom
	call $sooth_oom_trap(l %adj)
	hlt
@ok
	call $sooth_trace_event(l $allocfmt, l %adj)
	ret %p
}

function $sooth_free(l %p, l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	call $free(l %p)
	call $sooth_trace_event(l $freefmt, l %adj)
	ret
}

function $sooth_oom_trap(l %n) {
@start
	call $dprintf(w 2, l $oomfmt, l %n, ...)
	call $exit(w 1)
	hlt
}

function $sooth_trace_event(l %fmt, l %n) {
@start
	%e =l call $getenv(l $tracenv)
	%unset =w ceql %e, 0
	jnz %unset, @off, @set
@set
	%c =w loadub %e
	jnz %c, @on, @off
@on
	call $printf(l %fmt, l %n, ...)
	ret
@off
	ret
}
