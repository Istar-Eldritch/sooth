	%slen2 =l loadl %slena1
	call $printf(l $strfmt, l %slen2, l %sptr0, ...)
	jmp @blk3
@blk2
	%v6 =l copy $strd1
	%sptr3 =l loadl %v6
	%slena4 =l add %v6, 8
	%slen5 =l loadl %slena4
	call $printf(l $strfmt, l %slen5, l %sptr3, ...)
	jmp @blk3
@blk3
	ret
}

