	%v5 =w call $leap__m0(l %v4)
	call $.2e.__m2(w %v5)
	ret
}

export function $.2e.__m2(w %v0) {
@start
	%v3 =w copy 0
	%v4 =w ceqw %v0, %v3
	jnz %v4, @blk1, @blk2
@blk1
