data $fmt = { b "%ld\n", b 0 }
data $ufmt = { b "%lu\n", b 0 }
data $ffmt = { b "%g\n", b 0 }
data $sfmt = { b "%s", b 0 }
data $oobfmt = { b "sooth: array index out of range (line %ld)\n  index %ld is out of bounds for length %ld\n", b 0 }
data $allocfmt = { b "alloc %ld\n", b 0 }
data $freefmt = { b "free %ld\n", b 0 }
data $tracenv = { b "SOOTH_TRACE_ALLOC", b 0 }
data $oomfmt = { b "sooth: out of memory (allocation of %ld bytes failed)\n", b 0 }
data $strfmt = { b "%.*s", b 0 }
type :arr_0 = align 8 { b 24 }

export function :arr_0 $mk__m0(l %v0) {
@start
	%v1 =l copy 0
	%v2 =l copy 3
	%v3 =l alloc8 24
	%v4 =l copy 0
	jmp @blk1
@blk1
	%v5 =l phi @start %v4, @blk2 %v10
	%v6 =l copy 3
	%v7 =w csltl %v5, %v6
	jnz %v7, @blk2, @blk3
@blk2
	%eoff0 =l mul %v5, 8
	%v8 =l add %v3, %eoff0
	storel %v1, %v8
	%v9 =l copy 1
	%v10 =l add %v5, %v9
	jmp @blk1
@blk3
	%v11 =l add %v3, 0
	%v12 =l copy 0
	%v13 =l copy %v12
	%v14 =l copy 3
	%v15 =w cultl %v13, %v14
	jnz %v15, @blk4, @blk5
@blk5
	%v16 =l copy 16
	%v17 =l copy 3
	call $sooth_oob_trap(l %v16, l %v13, l %v17)
	jmp @blk4
@blk4
	%eoff1 =l mul %v13, 8
	%v18 =l add %v11, %eoff1
	storel %v0, %v18
	%v19 =l add %v3, 0
	%v20 =l copy 1
	%v21 =l copy %v20
	%v22 =l copy 3
	%v23 =w cultl %v21, %v22
	jnz %v23, @blk6, @blk7
@blk7
	%v24 =l copy 17
	%v25 =l copy 3
	call $sooth_oob_trap(l %v24, l %v21, l %v25)
	jmp @blk6
@blk6
	%eoff2 =l mul %v21, 8
	%v26 =l add %v19, %eoff2
	%v27 =l copy 1
	%v28 =l add %v0, %v27
	storel %v28, %v26
	%v29 =l add %v3, 0
	%v30 =l copy 2
	%v31 =l copy %v30
	%v32 =l copy 3
	%v33 =w cultl %v31, %v32
	jnz %v33, @blk8, @blk9
@blk9
	%v34 =l copy 18
	%v35 =l copy 3
	call $sooth_oob_trap(l %v34, l %v31, l %v35)
	jmp @blk8
@blk8
	%eoff3 =l mul %v31, 8
	%v36 =l add %v29, %eoff3
	%v37 =l copy 2
	%v38 =l add %v0, %v37
	storel %v38, %v36
	ret %v3
}

export function $sooth_main() {
@start
	%v0 =l copy 3
	%v2 =l copy 0
	jmp @blk1
@blk1
	%v3 =l phi @start %v2, @blk30 %v74
	%v4 =l phi @start %v0, @blk30 %v4
	%v5 =w csltl %v3, %v4
	jnz %v5, @blk2, @blk3
@blk2
	%v8 =w copy 0
	jmp @blk4
@blk3
	%v9 =w csgtl %v3, %v4
	jnz %v9, @blk5, @blk6
@blk5
	%v12 =w copy 2
	jmp @blk7
@blk6
	%v13 =w copy 1
	jmp @blk7
@blk7
	%v14 =w phi @blk5 %v12, @blk6 %v13
	jmp @blk4
@blk4
	%v15 =w phi @blk2 %v8, @blk7 %v14
	%v19 =w copy 0
	%v20 =w ceqw %v15, %v19
	jnz %v20, @blk8, @blk11
@blk11
	%v21 =w copy 1
	%v22 =w ceqw %v15, %v21
	jnz %v22, @blk9, @blk10
@blk8
	%v23 =w copy 1
	jmp @blk12
@blk9
	%v24 =w copy 0
	jmp @blk12
@blk10
	%v25 =w copy 0
	jmp @blk12
@blk12
	%v26 =w phi @blk8 %v23, @blk9 %v24, @blk10 %v25
	%v29 =w copy %v26
	jnz %v29, @blk13, @blk14
@blk13
	%v30 =:arr_0 call $mk__m0(l %v3)
	%v32 =l copy 3
	%v33 =l copy %v32
	%v35 =l copy 0
	jmp @blk16
@blk16
	%v36 =l phi @blk13 %v35, @blk31 %v72
	%v37 =l phi @blk13 %v33, @blk31 %v37
	%v38 =w csltl %v36, %v37
	jnz %v38, @blk17, @blk18
@blk17
	%v41 =w copy 0
	jmp @blk19
@blk18
	%v42 =w csgtl %v36, %v37
	jnz %v42, @blk20, @blk21
@blk20
	%v45 =w copy 2
	jmp @blk22
@blk21
	%v46 =w copy 1
	jmp @blk22
@blk22
	%v47 =w phi @blk20 %v45, @blk21 %v46
	jmp @blk19
@blk19
	%v48 =w phi @blk17 %v41, @blk22 %v47
	%v52 =w copy 0
	%v53 =w ceqw %v48, %v52
	jnz %v53, @blk23, @blk26
@blk26
	%v54 =w copy 1
	%v55 =w ceqw %v48, %v54
	jnz %v55, @blk24, @blk25
@blk23
	%v56 =w copy 1
	jmp @blk27
@blk24
	%v57 =w copy 0
	jmp @blk27
@blk25
	%v58 =w copy 0
	jmp @blk27
@blk27
	%v59 =w phi @blk23 %v56, @blk24 %v57, @blk25 %v58
	%v62 =w copy %v59
	jnz %v62, @blk28, @blk29
@blk28
	%v63 =l add %v30, 0
	%v64 =l copy %v36
	%v65 =l copy 3
	%v66 =w cultl %v64, %v65
	jnz %v66, @blk31, @blk32
@blk32
	%v67 =l copy 45
	%v68 =l copy 3
	call $sooth_oob_trap(l %v67, l %v64, l %v68)
	jmp @blk31
@blk31
	%eoff0 =l mul %v64, 8
	%v69 =l add %v63, %eoff0
	%v70 =l loadl %v69
	call $printf(l $fmt, l %v70, ...)
	%v71 =l copy 1
	%v72 =l add %v36, %v71
	jmp @blk16
@blk29
	jmp @blk30
@blk30
	%v73 =l copy 1
	%v74 =l add %v3, %v73
	jmp @blk1
@blk14
	jmp @blk15
@blk15
	ret
}

function $sooth_oob_trap(l %line, l %idx, l %len) {
@start
	call $dprintf(w 2, l $oobfmt, l %line, l %idx, l %len, ...)
	call $exit(w 1)
	hlt
}

function l $sooth_alloc(l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	%p =l call $malloc(l %adj)
	%isnull =w ceql %p, 0
	jnz %isnull, @oom, @ok
@oom
	call $sooth_oom_trap(l %adj)
	hlt
@ok
	call $sooth_trace_event(l $allocfmt, l %adj)
	ret %p
}

function $sooth_free(l %p, l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	call $free(l %p)
	call $sooth_trace_event(l $freefmt, l %adj)
	ret
}

function $sooth_oom_trap(l %n) {
@start
	call $dprintf(w 2, l $oomfmt, l %n, ...)
	call $exit(w 1)
	hlt
}

function $sooth_trace_event(l %fmt, l %n) {
@start
	%e =l call $getenv(l $tracenv)
	%unset =w ceql %e, 0
	jnz %unset, @off, @set
@set
	%c =w loadub %e
	jnz %c, @on, @off
@on
	call $printf(l %fmt, l %n, ...)
	ret
@off
	ret
}
