data $fmt = { b "%ld\n", b 0 }
data $ufmt = { b "%lu\n", b 0 }
data $ffmt = { b "%g\n", b 0 }
data $sfmt = { b "%s", b 0 }
data $oobfmt = { b "sooth: array index out of range (line %ld)\n  index %ld is out of bounds for length %ld\n", b 0 }
data $allocfmt = { b "alloc %ld\n", b 0 }
data $freefmt = { b "free %ld\n", b 0 }
data $tracenv = { b "SOOTH_TRACE_ALLOC", b 0 }
data $oomfmt = { b "sooth: out of memory (allocation of %ld bytes failed)\n", b 0 }
data $strfmt = { b "%.*s", b 0 }
data $strb0 = { b 101, b 120, b 97, b 109, b 112, b 108, b 101, b 115, b 47, b 114, b 101, b 115, b 111, b 117, b 114, b 99, b 101, b 95, b 102, b 105, b 120, b 116, b 117, b 114, b 101, b 46, b 116, b 120, b 116, b 0 }
data $strd0 = { l $strb0, l 29 }
type :arr_0 = align 1 { b 64 }
type :Fd = { l }
type :File = { :Fd }

export function $close__m0(:File %v0) {
@start
	call $sooth_struct_drop_1(:File %v0)
	ret
}

export function $sooth_main() {
@start
	%v0 =l copy $strd0
	%v1 =l loadl %v0
	%v2 =l copy 0
	%v3 =l call $open(l %v1, l %v2)
	%v4 =l alloc8 8
	%v5 =l add %v4, 0
	storel %v3, %v5
	%v6 =l alloc8 8
	%v7 =l add %v6, 0
	blit %v4, %v7, 8
	%v8 =l copy 0
	%v9 =w and %v8, 255
	%v10 =l copy 64
	%v11 =l alloc4 64
	%v12 =l copy 0
	jmp @blk1
@blk1
	%v13 =l phi @start %v12, @blk2 %v18
	%v14 =l copy 64
	%v15 =w csltl %v13, %v14
	jnz %v15, @blk2, @blk3
@blk2
	%eoff0 =l mul %v13, 1
	%v16 =l add %v11, %eoff0
	storeb %v9, %v16
	%v17 =l copy 1
	%v18 =l add %v13, %v17
	jmp @blk1
@blk3
	%v19 =l add %v6, 0
	%v20 =l add %v19, 0
	%v21 =l add %v20, 0
	%v22 =l loadl %v21
	%v23 =l add %v11, 0
	%v24 =l copy 64
	%v25 =l copy %v24
	%v26 =l call $read(l %v22, l %v23, l %v25)
	call $printf(l $fmt, l %v26, ...)
