data $fmt = { b "%ld\n", b 0 }
data $ufmt = { b "%lu\n", b 0 }
data $ffmt = { b "%g\n", b 0 }
data $sfmt = { b "%s", b 0 }
data $true_str = { b "true\n", b 0 }
data $false_str = { b "false\n", b 0 }
data $boolstrs = { l $false_str, l $true_str }
data $oobfmt = { b "sooth: array index out of range (line %ld)\n  index %ld is out of bounds for length %ld\n", b 0 }
data $allocfmt = { b "alloc %ld\n", b 0 }
data $freefmt = { b "free %ld\n", b 0 }
data $tracenv = { b "SOOTH_TRACE_ALLOC", b 0 }
data $oomfmt = { b "sooth: out of memory (allocation of %ld bytes failed)\n", b 0 }
data $strfmt = { b "%.*s", b 0 }
type :arr_0 = align 8 { b 40 }

export function :arr_0 $scores() {
@start
	%v0 =l copy 0
	%v1 =l copy 5
	%v2 =l alloc8 40
	%v3 =l add %v2, 0
	storel %v0, %v3
	%v4 =l add %v2, 8
	storel %v0, %v4
	%v5 =l add %v2, 16
	storel %v0, %v5
	%v6 =l add %v2, 24
	storel %v0, %v6
	%v7 =l add %v2, 32
	storel %v0, %v7
	%v8 =l add %v2, 0
	%v9 =l copy 0
	%v10 =l copy %v9
	%v11 =l copy 5
	%v12 =w cultl %v10, %v11
	jnz %v12, @blk1, @blk2
@blk2
	%v13 =l copy 10
	%v14 =l copy 5
	call $sooth_oob_trap(l %v13, l %v10, l %v14)
	jmp @blk1
@blk1
	%eoff0 =l mul %v10, 8
	%v15 =l add %v8, %eoff0
	%v16 =l copy 3
	storel %v16, %v15
	%v17 =l add %v2, 0
	%v18 =l copy 1
	%v19 =l copy %v18
	%v20 =l copy 5
	%v21 =w cultl %v19, %v20
	jnz %v21, @blk3, @blk4
@blk4
	%v22 =l copy 11
	%v23 =l copy 5
	call $sooth_oob_trap(l %v22, l %v19, l %v23)
	jmp @blk3
@blk3
	%eoff1 =l mul %v19, 8
	%v24 =l add %v17, %eoff1
	%v25 =l copy 7
	storel %v25, %v24
	%v26 =l add %v2, 0
	%v27 =l copy 2
	%v28 =l copy %v27
	%v29 =l copy 5
	%v30 =w cultl %v28, %v29
	jnz %v30, @blk5, @blk6
@blk6
	%v31 =l copy 12
	%v32 =l copy 5
	call $sooth_oob_trap(l %v31, l %v28, l %v32)
	jmp @blk5
@blk5
	%eoff2 =l mul %v28, 8
	%v33 =l add %v26, %eoff2
	%v34 =l copy 1
	storel %v34, %v33
	%v35 =l add %v2, 0
	%v36 =l copy 3
	%v37 =l copy %v36
	%v38 =l copy 5
	%v39 =w cultl %v37, %v38
	jnz %v39, @blk7, @blk8
@blk8
	%v40 =l copy 13
	%v41 =l copy 5
	call $sooth_oob_trap(l %v40, l %v37, l %v41)
	jmp @blk7
@blk7
	%eoff3 =l mul %v37, 8
	%v42 =l add %v35, %eoff3
	%v43 =l copy 9
	storel %v43, %v42
	%v44 =l add %v2, 0
	%v45 =l copy 4
	%v46 =l copy %v45
	%v47 =l copy 5
	%v48 =w cultl %v46, %v47
	jnz %v48, @blk9, @blk10
@blk10
	%v49 =l copy 14
	%v50 =l copy 5
	call $sooth_oob_trap(l %v49, l %v46, l %v50)
	jmp @blk9
@blk9
	%eoff4 =l mul %v46, 8
	%v51 =l add %v44, %eoff4
	%v52 =l copy 5
	storel %v52, %v51
	ret %v2
}

export function $sooth_main() {
@start
	%v0 =:arr_0 call $scores()
	%v1 =l copy 0
	%v2 =l copy 5
	%v4 =l copy 0
	jmp @blk1
@blk1
	%v5 =l phi @start %v1, @blk4 %v16
	%v6 =l phi @start %v4, @blk4 %v18
	%v7 =w csltl %v6, %v2
	jnz %v7, @blk2, @blk3
@blk2
	%v8 =l add %v0, 0
	%v9 =l copy %v6
	%v10 =l copy 5
	%v11 =w cultl %v9, %v10
	jnz %v11, @blk4, @blk5
@blk5
	%v12 =l copy 19
	%v13 =l copy 5
	call $sooth_oob_trap(l %v12, l %v9, l %v13)
	jmp @blk4
@blk4
	%eoff0 =l mul %v9, 8
	%v14 =l add %v8, %eoff0
	%v15 =l loadl %v14
	%v16 =l add %v5, %v15
	%v17 =l copy 1
	%v18 =l add %v6, %v17
	jmp @blk1
@blk3
	call $printf(l $fmt, l %v5, ...)
	%v19 =l copy 5
	%v21 =l copy 0
	jmp @blk6
@blk6
	%v22 =l phi @blk3 %v21, @blk11 %v42
	%v23 =w csltl %v22, %v19
	jnz %v23, @blk7, @blk8
@blk7
	%v24 =l add %v0, 0
	%v25 =l copy %v22
	%v26 =l copy 5
	%v27 =w cultl %v25, %v26
	jnz %v27, @blk9, @blk10
@blk10
	%v28 =l copy 20
	%v29 =l copy 5
	call $sooth_oob_trap(l %v28, l %v25, l %v29)
	jmp @blk9
@blk9
	%eoff1 =l mul %v25, 8
	%v30 =l add %v24, %eoff1
	%v31 =l loadl %v30
	%v32 =l copy 2
	%v33 =l mul %v31, %v32
	%v34 =l add %v0, 0
	%v35 =l copy %v22
	%v36 =l copy 5
	%v37 =w cultl %v35, %v36
	jnz %v37, @blk11, @blk12
@blk12
	%v38 =l copy 20
	%v39 =l copy 5
	call $sooth_oob_trap(l %v38, l %v35, l %v39)
	jmp @blk11
@blk11
	%eoff2 =l mul %v35, 8
	%v40 =l add %v34, %eoff2
	storel %v33, %v40
	%v41 =l copy 1
	%v42 =l add %v22, %v41
	jmp @blk6
@blk8
	%v43 =l copy 5
	%v45 =l copy 0
	jmp @blk13
@blk13
	%v46 =l phi @blk8 %v45, @blk16 %v57
	%v47 =w csltl %v46, %v43
	jnz %v47, @blk14, @blk15
@blk14
	%v48 =l add %v0, 0
	%v49 =l copy %v46
	%v50 =l copy 5
	%v51 =w cultl %v49, %v50
	jnz %v51, @blk16, @blk17
@blk17
	%v52 =l copy 21
	%v53 =l copy 5
	call $sooth_oob_trap(l %v52, l %v49, l %v53)
	jmp @blk16
@blk16
	%eoff3 =l mul %v49, 8
	%v54 =l add %v48, %eoff3
	%v55 =l loadl %v54
	call $printf(l $fmt, l %v55, ...)
	%v56 =l copy 1
	%v57 =l add %v46, %v56
	jmp @blk13
@blk15
	ret
}

function $sooth_oob_trap(l %line, l %idx, l %len) {
@start
	call $dprintf(w 2, l $oobfmt, l %line, l %idx, l %len, ...)
	call $exit(w 1)
	hlt
}

function l $sooth_alloc(l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	%p =l call $malloc(l %adj)
	%isnull =w ceql %p, 0
	jnz %isnull, @oom, @ok
@oom
	call $sooth_oom_trap(l %adj)
	hlt
@ok
	call $sooth_trace_event(l $allocfmt, l %adj)
	ret %p
}

function $sooth_free(l %p, l %n) {
@start
	%zero =l ceql %n, 0
	%adj =l add %n, %zero
	call $free(l %p)
	call $sooth_trace_event(l $freefmt, l %adj)
	ret
}

function $sooth_oom_trap(l %n) {
@start
	call $dprintf(w 2, l $oomfmt, l %n, ...)
	call $exit(w 1)
	hlt
}

function $sooth_trace_event(l %fmt, l %n) {
@start
	%e =l call $getenv(l $tracenv)
	%unset =w ceql %e, 0
	jnz %unset, @off, @set
@set
	%c =w loadub %e
	jnz %c, @on, @off
@on
	call $printf(l %fmt, l %n, ...)
	ret
@off
	ret
}
